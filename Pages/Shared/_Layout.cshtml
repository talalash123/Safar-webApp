<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Safar Terminal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Safar.styles.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .custom-navbar {
            background: #ffffff !important;
            border-bottom: 1px solid #e2e8f0 !important;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.02) !important;
            padding: 16px 0;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 22px;
            letter-spacing: -0.5px;
            transition: transform 0.2s ease;
        }

            .navbar-brand:hover {
                transform: scale(1.02);
            }

        .nav-link-custom {
            color: #475569 !important;
            font-weight: 600;
            font-size: 14px;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

            .nav-link-custom:hover {
                color: #004d26 !important;
                background-color: #e6f4ea;
            }

        .btn-admin-gate {
            color: #64748b !important;
            font-weight: 600;
            font-size: 13px;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            padding: 8px 16px !important;
            background-color: #ffffff;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
        }

            .btn-admin-gate:hover {
                color: #0f172a !important;
                border-color: #0f172a;
                background-color: #f1f5f9;
            }

        .main-wrapper {
            flex: 1;
            padding-bottom: 80px; /* Overlaps protection layout */
        }

        .custom-footer {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            color: #64748b;
            font-size: 13px;
            padding: 16px 0;
            margin-top: auto;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light custom-navbar">
            <div class="container">
                <a class="navbar-brand text-success" asp-page="/Customer/Index">
                    🇵🇰 SAFAR
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-page="/Customer/Index">🎫 Book Tickets</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="btn-admin-gate" asp-page="/Login">
                                ⚙️ Admin Dashboard
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-wrapper mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>&copy; 2026 - Safar Operational Fleet Terminal Management Suite</span>
            <div class="d-flex align-items-center gap-2">
                <div style="width: 7px; height: 7px; background: #22c55e; border-radius: 50%;"></div>
                <span class="text-success fw-bold" style="font-size: 12px; letter-spacing: 0.5px; text-transform: uppercase;">Active Instance</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- 🤖 Premium AI Chatbot Widget -->
    <style>
        .chat-fab {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, #004d26 0%, #003319 100%);
            color: #ffffff;
            border: none;
            font-size: 24px;
            cursor: pointer;
            z-index: 1050;
            box-shadow: 0 8px 24px rgba(0, 77, 38, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .chat-fab:hover { transform: scale(1.08); box-shadow: 0 12px 32px rgba(0, 77, 38, 0.45); }
        .chat-fab.active { transform: rotate(45deg) scale(1.05); background: #ef4444; }

        .chat-panel {
            position: fixed;
            bottom: 92px;
            right: 24px;
            width: 360px;
            max-height: 480px;
            z-index: 1049;
            border-radius: 20px;
            overflow: hidden;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            display: flex;
            flex-direction: column;
            opacity: 0;
            transform: translateY(20px) scale(0.95);
            pointer-events: none;
            transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .chat-panel.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }

        .chat-panel-header {
            background: linear-gradient(135deg, #004d26 0%, #003319 100%);
            color: #ffffff;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .chat-panel-header .chat-avatar {
            width: 36px; height: 36px;
            background: rgba(255,255,255,0.15);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
        }
        .chat-panel-header .chat-meta h6 { margin: 0; font-size: 14px; font-weight: 700; }
        .chat-panel-header .chat-meta span { font-size: 11px; opacity: 0.7; }
        .chat-status-dot { width: 8px; height: 8px; background: #34d399; border-radius: 50%; display: inline-block; margin-right: 4px; box-shadow: 0 0 0 2px rgba(52,211,153,0.3); }

        .chat-messages {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            background: #f8fafc;
            max-height: 300px;
            min-height: 200px;
        }
        .chat-messages::-webkit-scrollbar { width: 4px; }
        .chat-messages::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

        .chat-bubble {
            max-width: 85%;
            padding: 10px 14px;
            border-radius: 14px;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 10px;
            word-wrap: break-word;
            animation: bubbleIn 0.25s ease-out;
        }
        .chat-bubble.ai { background: #ffffff; border: 1px solid #e2e8f0; color: #334155; border-bottom-left-radius: 4px; }
        .chat-bubble.user { background: #004d26; color: #ffffff; margin-left: auto; border-bottom-right-radius: 4px; }

        @@keyframes bubbleIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        .typing-indicator { display: none; padding: 10px 14px; }
        .typing-indicator.visible { display: flex; }
        .typing-indicator span {
            width: 7px; height: 7px; background: #94a3b8; border-radius: 50%;
            display: inline-block; margin: 0 2px;
            animation: typingBounce 1.2s ease-in-out infinite;
        }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes typingBounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }

        .chat-input-bar {
            padding: 12px 16px;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
            display: flex;
            gap: 8px;
        }
        .chat-input-bar input {
            flex: 1; border: 1.5px solid #e2e8f0; border-radius: 10px;
            padding: 10px 14px; font-size: 13px; outline: none;
            transition: border-color 0.2s;
        }
        .chat-input-bar input:focus { border-color: #004d26; }
        .chat-input-bar button {
            background: #004d26; color: #fff; border: none;
            border-radius: 10px; padding: 10px 16px;
            font-weight: 700; font-size: 13px; cursor: pointer;
            transition: all 0.2s;
        }
        .chat-input-bar button:hover { background: #003319; }

        @@media (max-width: 480px) {
            .chat-panel { width: calc(100vw - 32px); right: 16px; bottom: 84px; }
        }
    </style>

    <button class="chat-fab" id="chatToggle" title="Safar AI Support">💬</button>

    <div class="chat-panel" id="chatPanel">
        <div class="chat-panel-header">
            <div class="chat-avatar">🤖</div>
            <div class="chat-meta">
                <h6>Safar AI Support</h6>
                <span><span class="chat-status-dot"></span>ML-Powered • Always Online</span>
            </div>
        </div>
        <div class="chat-messages" id="chat-history">
            <div class="chat-bubble ai">👋 Hello! I'm the Safar AI assistant. Ask me about booking, cancellations, payments, or routes!</div>
        </div>
        <div class="typing-indicator" id="typingIndicator">
            <div class="chat-bubble ai" style="display: flex; gap: 2px; padding: 12px 16px;">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="chat-input-bar">
            <input type="text" id="chat-input" placeholder="Ask a question..." autocomplete="off" />
            <button id="chat-send">Send</button>
        </div>
    </div>
</body>
</html>