<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Safar Terminal</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<style>
    :root {
        --pakistan-green: #004d26;
        --pakistan-green-light: #e6f4ea;
        --pakistan-green-hover: rgba(0, 77, 38, 0.08);
        --premium-white: #ffffff;
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-100: #f1f5f9;
        --slate-50: #f8fafc;
        --sidebar-width: 260px;
        --border-color: #f1f5f9;
        --radius-md: 10px;
        --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body, html {
        margin: 0;
        padding: 0;
        height: 100vh;
        background-color: var(--slate-50);
        font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
        color: var(--slate-900);
        -webkit-font-smoothing: antialiased;
    }

    /* Fixed Sidebar Navigation */
    .admin-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-width);
        background: var(--premium-white);
        border-right: 1px solid var(--border-color);
        box-shadow: 4px 0 24px rgba(15, 23, 42, 0.015);
        display: flex;
        flex-direction: column;
        z-index: 1050;
    }

    .sidebar-brand {
        padding: 24px 20px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 12px;
        height: 75px; /* Fixed height for header alignment */
        box-sizing: border-box;
    }

    .sidebar-brand h4 {
        margin: 0;
        font-weight: 800;
        color: var(--pakistan-green);
        letter-spacing: -0.5px;
        font-size: 19px;
    }

    /* Enhanced Scrollable Menu Container */
    .sidebar-menu {
        padding: 24px 14px;
        flex-grow: 1;
        overflow-y: auto;
    }

    /* Custom Sleek Scrollbar for Sidebar Links */
    .sidebar-menu::-webkit-scrollbar {
        width: 5px;
    }
    .sidebar-menu::-webkit-scrollbar-track {
        background: transparent;
    }
    .sidebar-menu::-webkit-scrollbar-thumb {
        background: var(--slate-100);
        border-radius: 10px;
    }
    .sidebar-menu::-webkit-scrollbar-thumb:hover {
        background: var(--slate-500);
    }

    /* Premium Functional Links */
    .menu-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        color: var(--slate-600);
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        border-radius: var(--radius-md);
        margin-bottom: 6px;
        position: relative;
        transition: var(--transition-smooth);
    }

    /* Hover State with subtle push effect */
    .menu-link:hover {
        background: var(--slate-50);
        color: var(--pakistan-green);
        padding-left: 20px; /* Slight micro-movement */
    }

    /* Active Routing Node Highlights */
    .menu-link.active-node {
        background: var(--pakistan-green-light) !important;
        color: var(--pakistan-green) !important;
        font-weight: 700;
        padding-left: 20px;
    }

    /* Refined Active Left Bar Indicator */
    .menu-link.active-node::before {
        content: '';
        position: absolute;
        left: 0;
        top: 20%;
        height: 60%;
        width: 4px;
        background-color: var(--pakistan-green);
        border-radius: 0 4px 4px 0;
    }

    /* Menu Icons Sync (If you are using SVG or FontAwesome inside .menu-link) */
    .menu-link i, .menu-link svg {
        font-size: 18px;
        transition: var(--transition-smooth);
        color: var(--slate-500);
    }
    .menu-link:hover i, .menu-link:hover svg,
    .menu-link.active-node i, .menu-link.active-node svg {
        color: var(--pakistan-green);
    }

    /* Sidebar Footer Enhancement */
    .sidebar-footer {
        padding: 18px 20px;
        border-top: 1px solid var(--border-color);
        background: var(--slate-50);
        margin-top: auto;
    }

    /* Centralized View Injection Workspace */
    .admin-main-content {
        margin-left: var(--sidebar-width);
        padding: 40px;
        min-height: 100vh;
        background-color: var(--slate-50);
        box-sizing: border-box;
    }

        @@media (max-width: 768px) {
            .admin-sidebar {
                transform: translateX(-100%);
                transition: var(--transition-smooth);
            }

            .admin-main-content {
                margin-left: 0;
                padding: 20px;
            }
            /* dynamic class to toggle sidebar on mobile if needed */
            .admin-sidebar.open {
                transform: translateX(0);
            }
        }
    }
</style>
</head>
<body>

    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <span style="font-size: 18px;">🇵🇰</span>
            <div>
                <h4>SAFAR</h4>
                <small style="font-size: 9px; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Smart Railway</small>
            </div>
        </div>

        <nav class="sidebar-menu">
            <a href="/Admin/Dashboard" class="menu-link">
                <span>📊</span> Dashboard Core
            </a>

            <a href="/Admin/Trains/Index" class="menu-link">
                <span>🚆</span> Fleet Management
            </a>

            <a href="/Admin/Schedules/Index" class="menu-link">
                <span>📅</span> Route Schedules
            </a>

            <a href="/Admin/Bookings" class="menu-link">
                <span>🎟️</span> Pass Bookings
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="d-flex align-items-center gap-2">
                <div style="width: 6px; height: 6px; background: #22c55e; border-radius: 50%;"></div>
                <span style="font-size: 11px; font-weight: 700; color: var(--slate-800);">Node Active: Admin</span>
            </div>
        </div>
    </aside>

    <main class="admin-main-content">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname.toLowerCase();
            const links = document.querySelectorAll(".menu-link");

            links.forEach(link => {
                link.classList.remove("active-node");
                const hrefAttr = link.getAttribute("href").toLowerCase();

                if (currentPath === hrefAttr || currentPath.startsWith(hrefAttr + "/")) {
                    link.classList.add("active-node");
                }
            });
        });
    </script>
</body>
</html>