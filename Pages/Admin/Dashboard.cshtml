@page
@model Safar.Pages.Admin.DashboardModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Operations Control Desk";
}

<style>
    /* Executive Layout Grid System */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
        margin-bottom: 32px;
    }

    .kpi-card {
        background: var(--premium-white);
        border: 1px solid rgba(226, 232, 240, 0.7);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.015), 0 4px 12px -5px rgba(15, 23, 42, 0.01);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .kpi-card:hover {
            transform: translateY(-4px);
            border-color: rgba(0, 77, 38, 0.15);
            box-shadow: 0 20px 25px -5px rgba(0, 77, 38, 0.02), 0 10px 10px -5px rgba(0, 77, 38, 0.01);
        }

    .kpi-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--slate-500);
        text-transform: uppercase;
        letter-spacing: 0.75px;
    }

    .kpi-value {
        font-size: 30px;
        font-weight: 800;
        color: var(--slate-900);
        margin-top: 6px;
        letter-spacing: -0.5px;
    }

    /* Charts Matrix Grid Layouts */
    .charts-main-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 24px;
    }

    .charts-lower-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
    }

    .telemetry-card {
        background: var(--premium-white);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.01);
    }

    .section-heading {
        font-size: 15px;
        font-weight: 700;
        color: var(--slate-800);
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        letter-spacing: -0.2px;
    }

    /* Enhanced Pipeline Activity Feed */
    .activity-feed-container {
        position: relative;
        padding-left: 8px;
        margin-top: 8px;
    }

    .activity-log {
        display: flex;
        gap: 16px;
        font-size: 13px;
        font-weight: 500;
        padding-bottom: 20px;
        margin-bottom: 0;
        position: relative;
    }

        /* Modern Vertical Node Connectors */
        .activity-log::before {
            content: '';
            position: absolute;
            left: 60px;
            top: 16px;
            bottom: -20px;
            width: 2px;
            background: var(--slate-100);
        }

        .activity-log:last-child::before {
            display: none;
        }

    .activity-timestamp {
        font-size: 11px;
        color: var(--slate-400);
        font-weight: 700;
        min-width: 50px;
        text-align: right;
        padding-top: 2px;
    }

    /* Timeline Bullet Node */
    .activity-log::after {
        content: '';
        position: absolute;
        left: 58px;
        top: 6px;
        width: 6px;
        height: 6px;
        background: var(--slate-300);
        border-radius: 50%;
        border: 2px solid var(--premium-white);
        box-shadow: 0 0 0 2px var(--slate-100);
        z-index: 2;
        transition: all 0.2s ease;
    }

    .activity-log:hover::after {
        background: var(--pakistan-green);
        box-shadow: 0 0 0 2px var(--pakistan-green-light);
    }

    .activity-details {
        padding-left: 12px;
    }

    /* Custom CSS Station Bar Vector Analytics */
    .station-bar {
        width: 42px;
        background: linear-gradient(180deg, var(--pakistan-green) 0%, #10b981 100%);
        border-radius: 6px 6px 0 0;
        position: relative;
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.1);
    }

        .station-bar:hover {
            opacity: 0.9;
            box-shadow: 0 4px 16px rgba(0, 77, 38, 0.2);
        }

        .station-bar::after {
            content: attr(data-value);
            position: absolute;
            top: -24px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 11px;
            font-weight: 700;
            color: var(--slate-700);
            letter-spacing: -0.2px;
        }

    /* Fix C# Compilation Inside Style Tags using Double @@ */
    @@media (max-width: 1200px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .charts-main-grid {
            grid-template-columns: 1fr;
        }

        .charts-lower-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .telemetry-card {
            padding: 20px;
        }
    }
</style>

