@page
@model Safar.Pages.Admin.Schedules.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Deploy Transits";
}

<style>
    .glass-form-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 20px;
        padding: 40px;
        max-width: 950px;
        box-shadow: 0 20px 40px -15px rgba(0, 77, 38, 0.03);
        margin-top: 24px;
    }

    .premium-label {
        font-size: 11px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 9px;
        display: block;
    }

    .premium-input {
        width: 100%;
        padding: 12px 16px;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        color: #0f172a;
        outline: none;
    }

    .terminal-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .day-pill-box {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 24px;
    }

    .day-checkbox {
        display: none;
    }

    .day-label {
        padding: 10px 20px;
        background: #f1f5f9;
        color: #475569;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .day-checkbox:checked + .day-label {
        background: rgba(0, 77, 38, 0.08);
        color: #004d26;
        border: 1px solid rgba(0, 77, 38, 0.2);
    }

    .stop-row {
        background: #dfefe !important;
        border-bottom: 1px solid #f1f5f9;
    }
</style>

<div class="container-fluid p-0">
    <div class="mb-4">
        <h2 style="font-weight: 800; color: #0f172a; letter-spacing: -0.8px;">Deploy Fleet Schedule</h2>
        <p class="text-muted small">Select an active train from your database fleet below to configure.</p>
    </div>

    <div class="glass-form-card">
        <form method="post" id="createForm">

            <div class="mb-4">
                <label class="premium-label" style="color: #004d26; font-weight: bold;">Active Locomotive Target</label>
                <select id="trainSelector" asp-for="ScheduleData.TrainId" class="form-select" style="height:55px; font-size:16px; border:2px solid #004d26; border-radius:12px;" required>
                    <option value="">-- Choose Registered Active Train --</option>
                    @if (Model.AvailableTrains != null)
                    {
                        @foreach (var option in Model.AvailableTrains)
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-4">
                <label class="premium-label">Select Weekly Operational Track Days</label>
                <div class="day-pill-box">
                    @{
                        string[] days = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
                        foreach (var day in days)
                        {
                            <input type="checkbox" name="SelectedDays" value="@day" id="day_@day" class="day-checkbox" />
                            <label for="day_@day" class="day-label">@day</label>
                        }
                    }
                </div>
            </div>

            <div>
                <h4 style="font-weight: 700; color: #0f172a; font-size: 16px;" class="mb-3">🏁 Terminal Bounds Map</h4>

                <div class="terminal-card">
                    <span class="badge bg-success text-white mb-3 px-3 py-2">📍 Initial Source Station Base</span>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="premium-label">Station Origin Name</label>
                            <input type="text" id="srcStationInput" asp-for="ScheduleData.SourceStation" class="premium-input" placeholder="e.g., Rawalpindi" required />
                        </div>
                        <div class="col-md-4">
                            <label class="premium-label">Departure Clock Time</label>
                            <input type="hidden" name="ScheduleData.RouteStops[0].SequenceOrder" value="1" />
                            <input type="hidden" name="ScheduleData.RouteStops[0].StationName" id="srcMirror" />
                            <input type="hidden" name="ScheduleData.RouteStops[0].ArrivalTime" value="00:00" />
                            <input type="time" name="ScheduleData.RouteStops[0].DepartureTime" class="premium-input" value="08:00" required />
                            <input type="hidden" name="ScheduleData.RouteStops[0].PriceFromSource" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="premium-label">Base Tariff Rate</label>
                            <input type="text" class="premium-input" value="0 PKR (Fixed)" disabled />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="premium-label">Tracks Intermediate Stopovers Setup</label>
                    <table class="table align-middle">
                        <thead>
                            <tr class="text-secondary small fw-bold">
                                <th style="width: 60px;">Seq</th>
                                <th>Station Name</th>
                                <th>Arrival Time</th>
                                <th>Departure Time</th>
                                <th>Price Fare (PKR)</th>
                                <th style="width: 50px;">Remove</th>
                            </tr>
                        </thead>
                        <tbody id="stopsContainer"></tbody>
                    </table>
                    <button type="button" class="btn btn-light w-100 p-3 border fw-bold text-success" style="border-radius:10px;" onclick="addNewStopRow()">➕ Append Intermediate Route Node</button>
                </div>

                <div class="terminal-card mt-4">
                    <span class="badge bg-danger text-white mb-3 px-3 py-2">🏁 Final Terminal Route Bound</span>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="premium-label">Terminal Destination Name</label>
                            <input type="text" id="destStationInput" asp-for="ScheduleData.DestinationStation" class="premium-input" placeholder="e.g., Karachi" required />
                        </div>
                        <div class="col-md-4">
                            <label class="premium-label">Arrival Clock Time</label>
                            <input type="time" id="destArrivalTime" class="premium-input" value="20:00" required />
                        </div>
                        <div class="col-md-3">
                            <label class="premium-label">Total Full Journey Price (PKR)</label>
                            <input type="number" step="0.01" id="destTotalPrice" class="premium-input" placeholder="e.g., 2500" required />
                        </div>
                    </div>
                </div>
            </div>

            <div id="destinationInputsContainer"></div>

            <div class="row g-3 mt-4">
                <div class="col-md-8">
                    <button type="submit" class="btn btn-success p-3 w-100 fw-bold" style="background: #004d26; border-radius:12px;">💾 Complete Fleet Schedule Persistence</button>
                </div>
                <div class="col-md-4">
                    <a asp-page="./Index" class="btn btn-light w-100 p-3" style="border-radius: 12px; font-weight: 600;">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Dynamic row generation function
        function addNewStopRow() {
            const container = document.getElementById('stopsContainer');
            const tr = document.createElement('tr');
            tr.className = 'stop-row';
            tr.innerHTML = `
                        <td class="fw-bold text-muted seq-label" style="padding: 12px 8px;"></td>
                        <td><input type="text" class="premium-input stop-station" placeholder="Station Name" required /></td>
                        <td><input type="time" class="premium-input stop-arrival" value="12:00" required /></td>
                        <td><input type="time" class="premium-input stop-departure" value="12:30" required /></td>
                        <td><input type="number" step="0.01" class="premium-input stop-price" placeholder="Price" required /></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger px-2 py-1" onclick="this.closest('tr').remove(); reindexStops();">✕</button></td>
                    `;
            container.appendChild(tr);
            reindexStops();
        }

        // Realtime client visualization indexing mapping
        function reindexStops() {
            const rows = document.querySelectorAll('#stopsContainer .stop-row');
            rows.forEach((row, idx) => {
                row.querySelector('.seq-label').innerText = `#${idx + 1}`;
            });
        }

        // CRITICAL INTERCEPT ENGINE: Compile strict serial indices on form submission
        document.getElementById('createForm').addEventListener('submit', function (e) {
            // 1. Mirror origin station data safely into model array at index 0
            document.getElementById('srcMirror').value = document.getElementById('srcStationInput').value;

            // 2. Loop and structurally re-assign numeric key tokens to all active intermediate rows
            const rows = document.querySelectorAll('#stopsContainer .stop-row');
            let currentTrackPointer = 1; // Index 0 is reserved for source station

            rows.forEach((row) => {
                const stationInput = row.querySelector('.stop-station');
                const arrivalInput = row.querySelector('.stop-arrival');
                const departureInput = row.querySelector('.stop-departure');
                const priceInput = row.querySelector('.stop-price');

                // Explicit sequential name strings allocation to fulfill MVC Binder expectations
                stationInput.name = `ScheduleData.RouteStops[${currentTrackPointer}].StationName`;
                arrivalInput.name = `ScheduleData.RouteStops[${currentTrackPointer}].ArrivalTime`;
                departureInput.name = `ScheduleData.RouteStops[${currentTrackPointer}].DepartureTime`;
                priceInput.name = `ScheduleData.RouteStops[${currentTrackPointer}].PriceFromSource`;

                // Hidden Sequence order value injection matching index framework + 1
                let hiddenSeq = row.querySelector('.dynamic-seq-input');
                if (!hiddenSeq) {
                    hiddenSeq = document.createElement('input');
                    hiddenSeq.type = 'hidden';
                    hiddenSeq.className = 'dynamic-seq-input';
                    row.appendChild(hiddenSeq);
                }
                hiddenSeq.name = `ScheduleData.RouteStops[${currentTrackPointer}].SequenceOrder`;
                hiddenSeq.value = currentTrackPointer + 1;

                currentTrackPointer++;
            });

            // 3. Formulate the destination block configuration fields with the ultimate continuous index
            const destinationVal = document.getElementById('destStationInput').value;
            const destContainer = document.getElementById('destinationInputsContainer');

            destContainer.innerHTML = `
                        <input type="hidden" name="ScheduleData.RouteStops[${currentTrackPointer}].SequenceOrder" value="${currentTrackPointer + 1}" />
                        <input type="hidden" name="ScheduleData.RouteStops[${currentTrackPointer}].StationName" value="${destinationVal}" />
                        <input type="hidden" name="ScheduleData.RouteStops[${currentTrackPointer}].ArrivalTime" value="${document.getElementById('destArrivalTime').value}" />
                        <input type="hidden" name="ScheduleData.RouteStops[${currentTrackPointer}].DepartureTime" value="00:00" />
                        <input type="hidden" name="ScheduleData.RouteStops[${currentTrackPointer}].PriceFromSource" value="${document.getElementById('destTotalPrice').value}" />
                    `;
        });
    </script>
}