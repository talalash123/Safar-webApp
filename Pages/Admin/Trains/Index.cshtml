@page
@model Safar.Pages.Admin.Trains.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pakistan Fleet Infrastructure";
}
<style>
    /* 🎨 PK SAFAR PREMIUM REGISTRY DESIGN SYSTEM
       Theme: Enterprise Data Architecture with Deep Emerald & Sunset Accents
    */
    :root {
        --registry-bg: #ffffff;
        --bg-warm-beige: #fdfbf7;      /* Match with main dashboard canvas */
        --border-subtle: #e7e0d5;      /* Warm structural layout outline */
        --border-light: #f3ede2;       /* Tinted light divider */
        --text-dark: #0f172a;          /* Slate 900 for high-contrast titles */
        --text-slate: #334155;         /* Slate 700 for data parameters */
        --text-muted: #64748b;         /* Slate 500 for table meta headers */
        
        /* Brand Color Matrix */
        --brand-green: #004d26;
        --brand-green-hover: #003319;
        --brand-green-light: rgba(0, 77, 38, 0.05);
        
        /* Sunset Accent Engine */
        --accent-orange: #ea580c;
        --accent-orange-hover: #c2410c;
        --accent-orange-light: #fff7ed;
        
        /* Shadows Architecture */
        --block-shadow: 0 10px 30px -10px rgba(27, 38, 24, 0.04), 0 4px 12px -5px rgba(27, 38, 24, 0.02);
        --hover-shadow: 0 20px 40px -15px rgba(0, 77, 38, 0.08);
        --bezier-fast: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Premium Data Registry Card Wrapper */
    .registry-block {
        background: var(--registry-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 24px; /* Smoother premium layout corners */
        padding: 32px;
        box-shadow: var(--block-shadow);
        margin-top: 24px;
        transition: all 0.35s var(--bezier-fast);
        position: relative;
    }

    .registry-block:hover {
        box-shadow: var(--hover-shadow);
        border-color: rgba(0, 77, 38, 0.15);
    }

    /* Top Control Bar Layout Helper */
    .registry-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    /* Enterprise Search & Filter Box Component */
    .search-filter-box {
        padding: 14px 22px;
        background: #faf8f5; /* Subtle beige tint injection for input boxes */
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
        width: 380px;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--text-dark);
        outline: none;
        transition: all 0.3s var(--bezier-fast);
    }

    .search-filter-box::placeholder {
        color: #a1a1aa;
    }

    .search-filter-box:focus {
        border-color: var(--brand-green);
        background: #ffffff;
        box-shadow: 0 0 0 4px var(--brand-green-light);
    }

    /* High-End Clean Data Table Integration */
    .registry-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-top: 4px;
    }

    .registry-table th {
        background: #faf8f5; /* Tint matching input system headers */
        color: var(--text-muted);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--border-subtle);
    }

    /* Align sync with panel architecture corners */
    .registry-table th:first-child {
        border-top-left-radius: 12px;
        border-bottom-left-radius: 12px;
    }

    .registry-table th:last-child {
        border-top-right-radius: 12px;
        border-bottom-right-radius: 12px;
    }

    .registry-table td {
        padding: 18px 20px;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-slate);
        border-bottom: 1px solid var(--border-light);
        vertical-align: middle;
        transition: background 0.25s var(--bezier-fast);
    }

    .registry-table tr:last-child td {
        border-bottom: none; /* Safely removes grid base overlay line */
    }

    /* Soft fluid highlights on hovering active operational rows */
    .registry-table tr:hover td {
        background: rgba(253, 251, 247, 0.85); /* Smooth beige reflection on highlight */
        color: var(--text-dark);
    }

    /* Action Node Micro-Icon Buttons Setup */
    .action-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        border: none;
        text-decoration: none;
        transition: all 0.3s var(--bezier-fast);
        font-size: 14px;
        cursor: pointer;
    }

    /* Neutral Edit Node Trigger (Uses Brand Green Subtle Tones) */
    .btn-edit-node {
        background: var(--brand-green-light);
        color: var(--brand-green);
    }

    .btn-edit-node:hover {
        background: var(--brand-green);
        color: #ffffff;
        transform: translateY(-2px);
    }

    /* High-Alert Destructive Delete Trigger (Uses Orange/Red Accent Palette) */
    .btn-delete-node {
        background: #fff5f1;
        color: var(--accent-orange);
        margin-left: 8px;
    }

    .btn-delete-node:hover {
        background: var(--accent-orange);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(234, 88, 12, 0.15);
    }

    .btn-delete-node:active, .btn-edit-node:active, .btn-deploy:active {
        transform: translateY(0);
    }

    /* Dynamic Deployment Action Call-To-Action */
    .btn-deploy {
        background: var(--brand-green);
        color: #ffffff !important;
        border-radius: 16px;
        padding: 14px 28px;
        font-weight: 700;
        text-decoration: none;
        font-size: 13.5px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 20px -6px rgba(0, 77, 38, 0.35);
        transition: all 0.3s var(--bezier-fast);
        border: none;
        cursor: pointer;
    }

    .btn-deploy:hover {
        background: var(--brand-green-hover);
        transform: translateY(-2px);
        box-shadow: 0 12px 24px -6px rgba(0, 77, 38, 0.5);
    }

    /* Minimalist Operational Metric Badges */
    .pak-badge {
        font-size: 10px;
        font-weight: 800;
        background: var(--accent-orange-light);
        color: var(--accent-orange);
        padding: 5px 12px;
        border-radius: 8px;
        vertical-align: middle;
        margin-left: 10px;
        letter-spacing: 0.6px;
        border: 1px solid rgba(234, 88, 12, 0.1);
        display: inline-block;
        text-transform: uppercase;
    }

    /* Responsive Grid Compensations */
    @@media (max-width: 768px) {
        .registry-controls {
            flex-direction: column;
            align-items: stretch;
            gap: 16px;
        }

        .search-filter-box {
            width: 100%;
        }

        .registry-block {
            padding: 20px;
            overflow-x: auto;
            border-radius: 16px;
        }

        .registry-table {
            min-width: 600px;
        }
    }
</style>
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-weight: 800; color: #0f172a; letter-spacing: -0.5px; margin: 0;">Pakistan Sovereign Fleet Control</h2>
        <p style="font-size:14px; color: #64748b; margin-top: 4px;">Exclusive data cluster ledger managing tactical locomotives across Pakistan local terminals.</p>
    </div>
    <a href="/Admin/Trains/Add" class="btn-deploy">＋ Deploy New Locomotive</a>
</div>

<div class="registry-block">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <input type="text" id="fleetSearchField" class="search-filter-box" placeholder="🔍 Filter by Train Name or Code..." onkeyup="FilterFleetGridEngine()" />
        <span class="text-muted style-span" style="font-size: 13px; font-weight: 600;">Showing <span id="activeCount">@(Model.PakistanFleetRegistry?.Count ?? 0)</span> Active Deployed Units</span>
    </div>

    <table class="table table-borderless align-middle mb-0" id="fleetDataTable">
        <thead>
            <tr style="border-bottom: 1.5px solid #f1f5f9; font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
                <th>Serial Code</th>
                <th>Locomotive Engine Profile</th>
                <th>Operational Track Framework</th>
                <th>Volumetric Capacity</th>
                <th>Bogie Segments</th>
                <th>Status State</th>
                <th class="text-end" style="padding-right: 20px;">Administrative Operations</th>
            </tr>
        </thead>
        <tbody style="font-size: 14px; font-weight: 500;">
            @if (Model.PakistanFleetRegistry == null || !Model.PakistanFleetRegistry.Any())
            {
                <tr id="emptyPlaceholder">
                    <td colspan="7" class="text-center text-muted py-5">
                        <div style="font-size: 32px; margin-bottom: 8px;">📋</div>
                        <div style="font-weight: 700; color: #334155;">Sovereign Registry Vector Empty</div>
                        <div style="font-size: 12px; color: #94a3b8;">No registered locomotive entities discovered inside the database pipeline.</div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var train in Model.PakistanFleetRegistry)
                {
                    <tr style="border-bottom: 1px solid #f8fafc;" class="fleet-row-item">
                        <td style="font-weight: 800; color: #0f172a;" class="target-train-id">
                            @(string.IsNullOrEmpty(train.TrainId) ? "N/A" : train.TrainId)
                        </td>
                        <td class="target-train-name" style="font-weight:600; color:#334155;">
                            @(string.IsNullOrEmpty(train.Name) ? "Unnamed Train" : train.Name) <span class="pak-badge">PAK-RAIL</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2" style="font-size: 13px;">
                                <span class="badge bg-light text-dark border px-2 py-1">Source</span>
                                <span style="color: #004d26; font-weight: 700;">@(string.IsNullOrEmpty(train.DefaultSource) ? "Islamabad" : train.DefaultSource)</span>
                                <span class="text-muted">➔</span>
                                <span class="badge bg-light text-dark border px-2 py-1">Destination</span>
                                <span style="color: #b91c1c; font-weight: 700;">@(string.IsNullOrEmpty(train.DefaultDestination) ? "Karachi" : train.DefaultDestination)</span>
                            </div>
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(train.TotalCapacity) ? "0 Seats" : train.TotalCapacity.Contains("Seats") ? train.TotalCapacity : train.TotalCapacity + " Seats")
                        </td>

                        <td>
                            @(string.IsNullOrEmpty(train.TotalBogies) ? "0 Carriages" : train.TotalBogies.Contains("Carriages") ? train.TotalBogies : train.TotalBogies + " Carriages")
                        </td>
                        <td>
                            <span class="badge @(train.Status == "Active" ? "bg-success" : "bg-warning")" style="font-weight:700; font-size:11px;">
                                @(string.IsNullOrEmpty(train.Status) ? "Active" : train.Status)
                            </span>
                        </td>
                        <td class="text-end" style="padding-right: 12px;">
                            <a href="/Admin/Trains/Edit?id=@train.Id" class="action-icon-btn btn-edit-node" title="Edit Parameters">⚙️</a>
                            <a href="/Admin/Trains/Index?handler=PurgeAssetNode&id=@train.Id"
                               onclick="return confirm('Are you completely sure you want to permanently delete this locomotive instance from the sovereign registry matrix?')"
                               class="action-icon-btn btn-delete-node" title="Purge Asset">🗑️</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function FilterFleetGridEngine() {
            const query = document.getElementById('fleetSearchField').value.toLowerCase();
            const rows = document.getElementsByClassName('fleet-row-item');
            let counter = 0;

            for (let i = 0; i < rows.length; i++) {
                const idEl = rows[i].querySelector('.target-train-id');
                const nameEl = rows[i].querySelector('.target-train-name');

                // Safe checks inside Javascript to avoid crashes
                const trainId = idEl ? idEl.textContent.toLowerCase() : "";
                const trainName = nameEl ? nameEl.textContent.toLowerCase() : "";

                if (trainId.includes(query) || trainName.includes(query)) {
                    rows[i].style.display = "";
                    counter++;
                } else {
                    rows[i].style.display = "none";
                }
            }
            const activeCountEl = document.getElementById('activeCount');
            if (activeCountEl) {
                activeCountEl.textContent = counter;
            }
        }
    </script>
}