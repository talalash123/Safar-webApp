@page
@model Safar.Pages.Admin.Trains.AddModel
@{
    ViewData["Title"] = "Deploy Sovereign Asset";
}
<style>
    /* Premium Glassmorphic Form Container */
    .glass-form-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 20px;
        padding: 40px;
        max-width: 750px;
        box-shadow: 0 20px 40px -15px rgba(0, 77, 38, 0.03), 0 8px 16px -8px rgba(15, 23, 42, 0.01);
        margin-top: 24px;
        position: relative;
    }

    /* Optional: Form Rows Layout Wrapper for multi-column inputs */
    .form-row-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .input-wrapper {
        margin-bottom: 24px;
        position: relative;
    }

    /* Clean Corporate Labels */
    .premium-label {
        font-size: 11px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 9px;
        display: block;
        transition: color 0.2s ease;
    }

    .input-wrapper:focus-within .premium-label {
        color: #004d26; /* Input active hone par label color smoothly highlight hoga */
    }

    /* High-End Enterprise Inputs */
    .premium-input {
        width: 100%;
        padding: 14px 18px;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        color: #0f172a;
        outline: none;
        box-sizing: border-box;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        /* Interactive Focus States */
        .premium-input:focus {
            border-color: #004d26;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(0, 77, 38, 0.06);
        }

        /* Placeholder Styling for matching sleek aesthetic */
        .premium-input::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        /* Elegant Error Handling (Razor Pages validation error compatibility) */
        .premium-input.input-validation-error {
            border-color: #ef4444 !important;
            background: #fffafb;
        }

            .premium-input.input-validation-error:focus {
                box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.08) !important;
            }

    /* High-Performance Submit/Sync Button */
    .btn-sync-fleet {
        background: #004d26;
        color: #ffffff;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: -0.1px;
        padding: 16px 32px;
        border: none;
        border-radius: 12px;
        width: 100%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 10px 20px -6px rgba(0, 77, 38, 0.25);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        /* Micro-interactions on Hover & Click active states */
        .btn-sync-fleet:hover {
            background: #06391d;
            transform: translateY(-2px);
            box-shadow: 0 12px 24px -5px rgba(0, 77, 38, 0.35);
        }

        .btn-sync-fleet:active {
            transform: translateY(0) scale(0.98); /* Click par real compression effect milega */
        }

        /* Sync Button Loading state support (if applied in operations) */
        .btn-sync-fleet i, .btn-sync-fleet svg {
            font-size: 16px;
            transition: transform 0.3s ease;
        }

        .btn-sync-fleet:hover i, .btn-sync-fleet:hover svg {
            transform: scale(1.1);
        }

    /* Responsive adjustment for forms built inside grid layout rows */
    @@media (max-width: 768px) {
        .form-row-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .glass-form-card {
            padding: 24px;
        }
    }
</style>

<div class="container-fluid" style="max-width: 750px; margin-top: 20px;">
    <div class="mb-3">
        <span class="badge mb-2" style="background: #e6f4ea; color: #004d26; font-weight: 700; font-size: 11px; padding: 6px 12px; border-radius: 6px;">FLEET WING</span>
        <h2 style="font-weight: 800; color: #0f172a;">Deploy New Locomotive Asset</h2>
        <p class="text-muted">Register a train profile along with its operational base terminals.</p>
    </div>

    <div class="card p-4 border-0 shadow-sm" style="border-radius: 16px; background:#ffffff; border: 1px solid #e2e8f0 !important;">
        <form method="post">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small text-uppercase" style="font-size:11px;">Train Code / Serial ID</label>
                    <input type="text" asp-for="NewTrain.TrainId" class="form-control form-control-lg" placeholder="e.g., T1" style="border-radius:10px; font-size:14px;" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small text-uppercase" style="font-size:11px;">Locomotive Model Name</label>
                    <input type="text" asp-for="NewTrain.Name" class="form-control form-control-lg" placeholder="e.g., IslamabadExpress" style="border-radius:10px; font-size:14px;" required />
                </div>
            </div>

            <div class="row mb-3" style="background: #f8fafc; padding: 15px; border-radius: 12px; margin: 0 0 16px 0; border: 1px solid #e2e8f0;">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-success small text-uppercase" style="font-size:11px;">Operational From (Default Source)</label>
                    <input type="text" asp-for="NewTrain.DefaultSource" class="form-control" placeholder="e.g., Islamabad" style="border-radius:8px;" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-success small text-uppercase" style="font-size:11px;">Operational To (Default Destination)</label>
                    <input type="text" asp-for="NewTrain.DefaultDestination" class="form-control" placeholder="e.g., Karachi" style="border-radius:8px;" required />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small text-uppercase" style="font-size:11px;">Passenger Seating Capacity</label>
                    <input type="number" asp-for="NewTrain.TotalCapacity" class="form-control" style="border-radius:8px;" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small text-uppercase" style="font-size:11px;">Total Coaches / Bogies</label>
                    <input type="number" asp-for="NewTrain.TotalBogies" class="form-control" style="border-radius:8px;" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-secondary small text-uppercase" style="font-size:11px;">Status</label>
                <select asp-for="NewTrain.Status" class="form-select" style="border-radius:8px;">
                    <option value="Active">Active Operational Service</option>
                    <option value="In-Maintenance">In-Maintenance</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success w-100 py-3 fw-bold" style="background: #004d26; border-radius: 12px; border:none;">
                ⚡ Synchronize Asset Registry & Return ➔
            </button>
        </form>
    </div>
</div>