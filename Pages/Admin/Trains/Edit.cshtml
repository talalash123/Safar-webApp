@page
@model Safar.Pages.Admin.Trains.EditModel
@{
    ViewData["Title"] = "Modify Locomotive Parameters";
}
<style>
    /* Premium Glassmorphic Edit Container */
    .glass-edit-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 20px;
        padding: 40px;
        max-width: 750px;
        box-shadow: 0 20px 40px -15px rgba(0, 77, 38, 0.03), 0 8px 16px -8px rgba(15, 23, 42, 0.01);
        margin-top: 24px;
        position: relative;
    }

    /* Multi-column grid support for edit fields if needed */
    .form-row-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .input-wrapper {
        margin-bottom: 24px;
        position: relative;
    }

    /* Clean Corporate Labels */
    .premium-label {
        font-size: 11px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 9px;
        display: block;
        transition: color 0.2s ease;
    }

    .input-wrapper:focus-within .premium-label {
        color: #004d26; /* Active input par label premium corporate green color trigger karega */
    }

    /* High-End Operational Inputs */
    .premium-input {
        width: 100%;
        padding: 14px 18px;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        color: #0f172a;
        outline: none;
        box-sizing: border-box;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        /* Interactive Input States */
        .premium-input:focus {
            border-color: #004d26;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(0, 77, 38, 0.06);
        }

        .premium-input::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        /* Validation Fail Fallback */
        .premium-input.input-validation-error {
            border-color: #ef4444 !important;
            background: #fffafb;
        }

            .premium-input.input-validation-error:focus {
                box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.08) !important;
            }

    /* 🛠️ Dual Action Button Group (Aligns Update & Cancel side-by-side cleanly) */
    .action-button-group {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }

    /* High-Performance Update/Save Action */
    .btn-update-fleet {
        flex: 2; /* Commit button ko thoda wide spatial precedence deta hai */
        background: #004d26;
        color: #ffffff;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: -0.1px;
        padding: 16px 32px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 10px 20px -6px rgba(0, 77, 38, 0.25);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .btn-update-fleet:hover {
            background: #06391d;
            transform: translateY(-2px);
            box-shadow: 0 12px 24px -5px rgba(0, 77, 38, 0.35);
        }

        .btn-update-fleet:active {
            transform: translateY(0) scale(0.98);
        }

    /* Sleek Neutral Cancel Action */
    .btn-cancel {
        flex: 1; /* Cancel link secondary control layer standard map karega */
        background: #f1f5f9;
        color: #475569;
        font-weight: 600;
        font-size: 14px;
        padding: 16px 32px;
        border-radius: 12px;
        border: 1px solid transparent;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        transition: all 0.2s ease;
    }

        .btn-cancel:hover {
            background: #e2e8f0;
            color: #0f172a;
            border-color: #cbd5e1;
        }

        .btn-cancel:active {
            transform: scale(0.99);
        }

    /* Responsive Grid Tweak for Razor Media Compilations */
    @@media (max-width: 768px) {
        .form-row-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .action-button-group {
            flex-direction: column;
            gap: 12px;
        }

        .glass-edit-card {
            padding: 24px;
        }
    }
</style>

<div class="container-fluid" style="max-width: 750px; margin-top: 20px;">
    <div class="mb-2">
        <span class="badge mb-2" style="background: #fff7ed; color: #c2410c; font-weight: 700; font-size: 11px; padding: 6px 12px; border-radius: 6px;">CONFIGURATION ENGINE</span>
        <h2 style="font-weight: 800; color: #0f172a; letter-spacing: -0.7px; margin: 0;">Modify Locomotive Parameters</h2>
        <p style="font-size: 14px; color: #64748b; margin-top: 4px;">Update capacity matrices, operational route terminals, or structural identifiers for this active token.</p>
    </div>

    <div class="glass-edit-card">
        <form method="post">
            <input type="hidden" asp-for="SelectedTrain.Id" />

            <div class="row">
                <div class="col-md-6 input-wrapper">
                    <label class="premium-label">Train Code / Serial ID</label>
                    <input type="text" asp-for="SelectedTrain.TrainId" class="premium-input" required />
                </div>
                <div class="col-md-6 input-wrapper">
                    <label class="premium-label">Locomotive Model Name</label>
                    <input type="text" asp-for="SelectedTrain.Name" class="premium-input" required />
                </div>
            </div>

            <div class="row mb-2" style="background: #f8fafc; padding: 20px 10px 0 10px; border-radius: 14px; border: 1px dashed #e2e8f0; margin: 0 0 24px 0;">
                <div class="col-md-6 input-wrapper">
                    <label class="premium-label" style="color: #004d26;">Operational From (Source)</label>
                    <input type="text" asp-for="SelectedTrain.DefaultSource" class="premium-input" style="background: #ffffff;" placeholder="e.g., Karachi Cantt" required />
                </div>
                <div class="col-md-6 input-wrapper">
                    <label class="premium-label" style="color: #004d26;">Operational To (Destination)</label>
                    <input type="text" asp-for="SelectedTrain.DefaultDestination" class="premium-input" style="background: #ffffff;" placeholder="e.g., Lahore Cantt" required />
                </div>
            </div>

            <div class="p-3 mb-4" style="background: #fff; border: 1px dashed #cbd5e1; border-radius: 14px;">
                <h6 class="fw-bold text-dark text-uppercase mb-3" style="font-size: 11px; letter-spacing: 0.5px;">🗂️ Class Breakdown & Allocations</h6>

                <div class="row mb-2 align-items-center">
                    <div class="col-md-6 mb-2 mb-md-0">
                        <label class="form-label text-success small fw-bold mb-1">🟢 Economy Bogies Count</label>
                        <input type="number" id="ecoBogies" asp-for="EconomyBogies" class="form-control form-control-sm" style="border-radius:6px;" min="0" oninput="CalculateTotalFleetSummary()" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold mb-1">Seats Per Economy Bogie</label>
                        <input type="number" id="ecoSeats" asp-for="EconomySeatsPerBogie" class="form-control form-control-sm" style="border-radius:6px;" min="0" oninput="CalculateTotalFleetSummary()" />
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <div class="col-md-6 mb-2 mb-md-0">
                        <label class="form-label text-primary small fw-bold mb-1">🔵 Business Bogies Count</label>
                        <input type="number" id="bizBogies" asp-for="BusinessBogies" class="form-control form-control-sm" style="border-radius:6px;" min="0" oninput="CalculateTotalFleetSummary()" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold mb-1">Seats Per Business Bogie</label>
                        <input type="number" id="bizSeats" asp-for="BusinessSeatsPerBogie" class="form-control form-control-sm" style="border-radius:6px;" min="0" oninput="CalculateTotalFleetSummary()" />
                    </div>
                </div>

                <div class="row align-items-center">
                    <div class="col-md-6 mb-2 mb-md-0">
                        <label class="form-label text-danger small fw-bold mb-1">🔴 Executive Bogies Count</label>
                        <input type="number" id="execBogies" asp-for="ExecutiveBogies" class="form-control form-control-sm" style="border-radius:6px;" min="0" oninput="CalculateTotalFleetSummary()" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold mb-1">Seats Per Executive Bogie</label>
                        <input type="number" id="execSeats" asp-for="ExecutiveSeatsPerBogie" class="form-control form-control-sm" style="border-radius:6px;" min="0" oninput="CalculateTotalFleetSummary()" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 input-wrapper">
                    <label class="premium-label">Passenger Seating Capacity</label>
                    <input type="text" id="lblTotalSeats" class="premium-input" style="background: #f1f5f9; font-weight: 600;" readonly />
                    <input type="hidden" id="hdnTotalSeats" asp-for="SelectedTrain.TotalCapacity" />
                </div>
                <div class="col-md-6 input-wrapper">
                    <label class="premium-label">Total Coaches / Bogies</label>
                    <input type="text" id="lblTotalBogies" class="premium-input" style="background: #f1f5f9; font-weight: 600;" readonly />
                    <input type="hidden" id="hdnTotalBogies" asp-for="SelectedTrain.TotalBogies" />
                </div>
            </div>

            <div class="input-wrapper mb-4">
                <label class="premium-label">Deployment Operational Status</label>
                <select asp-for="SelectedTrain.Status" class="premium-input">
                    <option value="Active">Active Operational Service</option>
                    <option value="In-Maintenance">In-Maintenance Quarantine</option>
                </select>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <a href="/Admin/Trains/Index" class="btn-cancel">✕ Abort Changes</a>
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn-update-fleet">
                        💾 Push System Updates ➔
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function CalculateTotalFleetSummary() {
            const ecoB = parseInt(document.getElementById('ecoBogies').value) || 0;
            const ecoS = parseInt(document.getElementById('ecoSeats').value) || 0;

            const bizB = parseInt(document.getElementById('bizBogies').value) || 0;
            const bizS = parseInt(document.getElementById('bizSeats').value) || 0;

            const execB = parseInt(document.getElementById('execBogies').value) || 0;
            const execS = parseInt(document.getElementById('execSeats').value) || 0;

            const totalBogies = ecoB + bizB + execB;
            const totalSeats = (ecoB * ecoS) + (bizB * bizS) + (execB * execS);

            document.getElementById('lblTotalBogies').value = totalBogies + " Carriages";
            document.getElementById('lblTotalSeats').value = totalSeats + " Seats";

            document.getElementById('hdnTotalBogies').value = totalBogies + " Carriages";
            document.getElementById('hdnTotalSeats').value = totalSeats + " Seats";
        }

        document.addEventListener("DOMContentLoaded", function() {
            CalculateTotalFleetSummary();
        });
    </script>
}