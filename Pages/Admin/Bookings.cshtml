@page
@model Safar.Pages.Admin.BookingsModel
@{
    ViewData["Title"] = "Pass Bookings Ledger";
}

<style>
    /* Premium Booking Engine Design Variables & Custom Tokens */
    :root {
        --glass-bg: #ffffff;
        --bg-warm-beige: #fdfbf7; /* Premium off-white beige tone */
        --border-color: rgba(231, 224, 213, 0.6); /* Warm subtle border */
        --text-main: #0f172a;
        --text-muted: #64748b;
        
        /* Brand Color Palette */
        --primary-green: #004d26; /* Deep Emerald Green */
        --primary-green-light: rgba(0, 77, 38, 0.05);
        --accent-orange: #ea580c; /* Crisp Sunset Orange */
        --accent-orange-light: #fff7ed;
        --warm-gold: #d97706; /* Secondary Amber for premium tiers */
    
        --card-shadow: 0 10px 30px -10px rgba(27, 38, 24, 0.04), 0 4px 12px -5px rgba(27, 38, 24, 0.02);
    }

    /* Container Transitions & Base Styling */
    .ledger-container {
        animation: fadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        background: var(--bg-warm-beige);
        padding: 24px;
        border-radius: 24px;
    }

    /* Modern Minimalist Form Controls */
    .search-wrapper {
        background: #ffffff;
        border: 1.5px solid var(--border-color);
        border-radius: 14px;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.01);
        transition: all 0.3s ease;
    }

    .search-wrapper:focus-within {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 4px rgba(0, 77, 38, 0.08);
        background: #ffffff;
    }

    .search-input {
        border: none;
        outline: none;
        width: 100%;
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text-main);
        padding-left: 10px;
    }

    /* Elegant Tables Structure */
    .modern-table-card {
        background: var(--glass-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px !important;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .modern-table thead {
        background: #fcfbfa; /* Soft warm setup for table header */
        border-bottom: 1px solid #f1ede4;
    }

    .modern-table th {
        font-size: 11px;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.9px;
        padding: 18px 20px !important;
    }

    .modern-table tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid #f8f6f0;
    }

    .modern-table tbody tr:hover {
        background-color: rgba(253, 251, 247, 0.9) !important;
    }

    .modern-table td {
        padding: 18px 20px !important;
        color: #334155;
        vertical-align: middle;
    }

    /* Custom Premium Badges & Pills */
    .pnr-badge {
        background: var(--primary-green-light);
        color: var(--primary-green);
        font-family: 'SF Mono', SFMono-Regular, Consolas, monospace;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid rgba(0, 77, 38, 0.12);
        font-size: 13px;
        letter-spacing: 0.5px;
    }

    .class-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 6px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .class-business {
        background: var(--primary-green-light);
        color: var(--primary-green);
        border: 1px solid rgba(0, 77, 38, 0.18);
    }

    .class-economy {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .class-executive {
        background: var(--accent-orange-light);
        color: var(--accent-orange);
        border: 1px solid rgba(234, 88, 12, 0.18);
    }

    .class-default {
        background: #f1f5f9;
        color: #475569;
    }

    .seat-pill {
        background: #ffffff;
        color: #1e293b;
        font-weight: 700;
        font-size: 11.5px;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }

    /* Status Config */
    .status-paid {
        background: var(--primary-green) !important;
        color: #ffffff !important;
        font-weight: 700;
        border-radius: 8px;
        padding: 6px 14px !important;
        font-size: 11.5px;
        letter-spacing: 0.5px;
        box-shadow: 0 3px 8px rgba(0, 77, 38, 0.15);
    }

    /* Route Visual Nodes */
    .route-node {
        position: relative;
        padding-left: 16px;
        font-weight: 600;
    }

    .route-node::before {
        content: '';
        position: absolute;
        left: 0;
        top: 7px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .route-source::before {
        background: var(--primary-green);
        box-shadow: 0 0 0 3px rgba(0, 77, 38, 0.15);
    }

    .route-dest::before {
        background: var(--accent-orange);
        box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* 🖨️ ULTRA STRICT PRINT OVERRIDES (ONLY TABLE WILL REMAIN) */
    @@media print {
        html, body {
            background: #ffffff !important;
            color: #000000 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        header, footer, nav, aside, 
        .sidebar, #sidebar, .navbar, .no-print, .mb-4,
        .main-header, .top-bar, .left-side, .right-side, .search-wrapper {
            display: none !important;
            visibility: hidden !important;
            width: 0 !important;
            height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .wrapper, .content-wrapper, .main-content, main, role[main] {
            margin-left: 0 !important;
            padding: 0 !important;
            border: none !important;
        }

        .ledger-container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            background: transparent !important;
        }

        .modern-table-card {
            border: none !important;
            box-shadow: none !important;
            background: transparent !important;
            overflow: visible !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .table-responsive {
            overflow: visible !important;
            display: block !important;
        }

        .modern-table {
            width: 100% !important;
            border-collapse: collapse !important;
        }

        .modern-table th, .modern-table td {
            border: 1px solid #94a3b8 !important; 
            padding: 8px 10px !important;
            font-size: 11px !important;
            color: #000000 !important;
        }

        th {
            background-color: #f1f5f9 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        
        .pnr-badge, .class-badge, .seat-pill, .status-paid {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            border: 1px solid #cbd5e1 !important;
            background: transparent !important;
            color: #000000 !important;
        }
    }
</style>

<div class="container-fluid p-0 ledger-container">

    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 no-print">
        <div>
            <span class="badge mb-2" style="background: rgba(0, 77, 38, 0.06); color: #004d26; font-weight: 700; font-size: 11px; padding: 6px 12px; border-radius: 6px;">CLUSTER TRANSACTION LOGS</span>
            <h2 style="font-weight: 800; color: #0f172a; letter-spacing: -0.8px; margin: 0;">🎟️ Live Pass Bookings Ledger</h2>
            <p class="text-muted small m-0 mt-1">Audit log of all processed and paid transit tickets inside the system context.</p>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <div class="search-wrapper">
                <span>🔍</span>
                <input type="text" id="tableSearch" class="search-input" placeholder="Search passenger, PNR or train..." onkeyup="filterLedgerTable()">
            </div>
            <button class="btn btn-light fw-bold border px-3 py-2" style="border-radius: 12px; font-size: 13px; background: #ffffff;" onclick="window.print();">
                📊 Export
            </button>
        </div>
    </div>

    <div class="card modern-table-card border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 modern-table" id="ledgerTable" style="background: #ffffff;">
                <thead>
                    <tr>
                        <th class="ps-4">PNR / Ticket</th>
                        <th>Lead Passenger</th>
                        <th>Train Profile</th>
                        <th>Route Block</th>
                        <th>Berths</th>
                        <th>Class</th>
                        <th>Total Fare</th>
                        <th class="pe-4 text-end">Status</th>
                    </tr>
                </thead>
                <tbody style="font-size: 13.5px;">
                    @if (Model.BookingsList.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="py-4">
                                    <span style="font-size: 32px;" class="d-block mb-2">📥</span>
                                    <h6 class="fw-bold text-dark m-0">No Core Transactions Detected</h6>
                                    <p class="text-muted small m-0 mt-1">No booking logs found in MongoDB stream query.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var booking in Model.BookingsList)
                        {
                            string classStyleClass = "class-default";
                            if (booking.SelectedClass == "Business") { classStyleClass = "class-business"; }
                            else if (booking.SelectedClass == "Economy") { classStyleClass = "class-economy"; }
                            else if (booking.SelectedClass == "Executive") { classStyleClass = "class-executive"; }

                            <tr>
                                <td class="ps-4">
                                    <span class="pnr-badge" title="Unique Transit Token ID">@booking.TicketNumber</span>
                                </td>

                                <td>
                                    <div class="fw-bold text-slate-900" style="font-size: 14px;">@booking.CustomerName</div>
                                    <div class="text-muted small" style="margin-top: 1px;">📱 @booking.CustomerPhone</div>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="font-size: 16px;">🚂</span>
                                        <span class="fw-semibold text-dark">@booking.TrainName</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <div class="route-node route-source text-muted small"><strong class="text-dark">@booking.SourceStation</strong></div>
                                        <div class="route-node route-dest text-muted small"><strong class="text-dark">@booking.DestinationStation</strong></div>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-1" style="max-width: 150px;">
                                        @foreach (var seat in booking.BookedSeats)
                                        {
                                            <span class="seat-pill">@seat</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <span class="badge class-badge @classStyleClass">@booking.SelectedClass</span>
                                </td>

                                <td class="fw-bold text-slate-900" style="font-size: 14.5px;">
                                    Rs. @booking.TotalFare.ToString("N0")
                                </td>

                                <td class="pe-4 text-end">
                                    <span class="badge status-paid">
                                        🟢 @booking.PaymentStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterLedgerTable() {
        var input = document.getElementById("tableSearch");
        var filter = input.value.toLowerCase();
        var table = document.getElementById("ledgerTable");
        var tr = table.getElementsByTagName("tr");

        for (var i = 1; i < tr.length; i++) {
            var rowText = tr[i].textContent || tr[i].innerText;
            if (rowText.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>