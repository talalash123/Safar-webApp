@page
@model Safar.Pages.Customer.TicketConfirmationModel
@{
    ViewData["Title"] = "Electronic Boarding Receipt";
}

<style>
    .invoice-ticket-shell {
        background: #ffffff;
        border: 2px solid #0f172a;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        position: relative;
        overflow: hidden;
    }
    .ticket-rip-line {
        border-top: 2px dashed #cbd5e1;
        margin: 30px 0;
        position: relative;
    }
    /* Printing Layout Overrides when Ctrl+P is hit */
    @@media print {
        body * { visibility: hidden; }
        .invoice-ticket-shell, .invoice-ticket-shell * { visibility: visible; }
        .invoice-ticket-shell { position: absolute; left: 0; top: 0; width: 100%; border: none; box-shadow: none; }
        .btn-print-bypass { display: none !important; }
    }
</style>

<div class="container" style="max-width: 700px; margin-top: 30px; margin-bottom: 50px;">

    <div class="text-center mb-4 btn-print-bypass">
        <span class="text-success fw-bold d-block mb-1">🎉 Transaction Processed Successfully!</span>
        <h4 class="fw-bold text-dark">Your Seats are Secured Securely</h4>
        <button onclick="window.print()" class="btn btn-dark px-4 py-2 fw-bold mt-2" style="border-radius:8px;">
            🖨️ Print Sovereign Boarding Pass
        </button>
    </div>

    <div class="invoice-ticket-shell">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-extrabold m-0" style="color:#004d26; font-weight:900;">SAFAR RAILWAYS</h3>
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:1px;">Sovereign Transit Document</span>
            </div>
            <div class="text-end">
                <span class="badge bg-dark px-3 py-2" style="font-size:13px;">PNR: @Model.TargetTicket.TicketNumber</span>
            </div>
        </div>

        <div class="row g-3 my-2 bg-light p-3 rounded-3" style="border: 1px solid #e2e8f0;">
            <div class="col-sm-6">
                <span class="text-secondary small d-block">LOCOMOTIVE PROFILE</span>
                <strong class="text-dark">🚂 @Model.TargetTicket.TrainName</strong>
            </div>
            <div class="col-sm-6">
                <span class="text-secondary small d-block">DATE OF DEPARTURE</span>
                <strong class="text-dark">📅 @Model.TargetTicket.TravelDate.ToString("dd MMMM, yyyy")</strong>
            </div>
        </div>

        <div class="row g-3 my-3">
            <div class="col-sm-6">
                <span class="text-secondary small d-block">ORIGIN ROUTE TERMINAL</span>
                <strong class="text-success" style="font-size:16px;">🟢 @Model.TargetTicket.SourceStation</strong>
            </div>
            <div class="col-sm-6">
                <span class="text-secondary small d-block">DESTINATION TERMINAL</span>
                <strong class="text-danger" style="font-size:16px;">🔴 @Model.TargetTicket.DestinationStation</strong>
            </div>
        </div>

        <div class="ticket-rip-line"></div>

        <div class="row g-3">
            <div class="col-sm-6">
                <span class="text-secondary small d-block">PRIMARY PASSENGER</span>
                <strong class="text-dark">@Model.TargetTicket.CustomerName</strong>
                <span class="text-muted d-block small">@Model.TargetTicket.CustomerPhone</span>
            </div>
            <div class="col-sm-6">
                <span class="text-secondary small d-block">IDENTITY CNIC</span>
                <strong class="text-dark">@Model.TargetTicket.CustomerCNIC</strong>
            </div>
        </div>

        <div class="row g-3 mt-3 p-3 rounded-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
            <div class="col-sm-4">
                <span class="text-secondary small d-block">CLASS ASSIGNED</span>
                <span class="badge bg-primary text-white mt-1">@Model.TargetTicket.SelectedClass</span>
            </div>
            <div class="col-sm-4">
                <span class="text-secondary small d-block">BERTH ALLOCATIONS</span>
                <strong class="text-success">🎫 @string.Join(", ", Model.TargetTicket.BookedSeats)</strong>
            </div>
            <div class="col-sm-4 text-sm-end">
                <span class="text-secondary small d-block">NET PAID FARE</span>
                <h4 class="fw-bold text-dark m-0" style="font-weight:800;">PKR @Model.TargetTicket.TotalFare.ToString("N0")</h4>
            </div>
        </div>

        <p class="text-center text-muted small m-0 mt-4" style="font-size:10px; line-height:1.4;">
            * This is an electronically generated transport ledger asset code token. Show this boarding invoice profile along with original CNIC mappings at checkpoints prior to departure schedules.
        </p>
    </div>
</div>