@page
@model Safar.Pages.Customer.PassengerInfoModel
@{
    ViewData["Title"] = "Passenger Manifest Registration - PK SAFAR";
}

<style>
    /* 🏛️ Modern Luxury Enterprise Design System Tokens */
    :root {
        --safar-green: #22c55e;
        --safar-green-dark: #16a34a;
        --safar-dark-slate: #0f172a;
        --safar-green-brand: #004d26;
        --safar-gold: #fbbf24;
        --text-slate: #334155;
        --text-muted: #64748b;
        --border-light: #e2e8f0;
        --radius-premium: 20px;
        --radius-interactive: 12px;
        --shadow-lg: 0 20px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
        --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        background-color: #f8fafc;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: var(--safar-dark-slate);
        -webkit-font-smoothing: antialiased;
    }

    /* 🛡️ Form Input Enhancement */
    .form-control, .form-select {
        border: 1.5px solid var(--border-light);
        padding: 12px 16px;
        font-size: 14.5px;
        color: var(--safar-dark-slate);
        font-weight: 500;
        border-radius: var(--radius-interactive) !important;
        transition: var(--transition-smooth);
        background-color: #ffffff;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--safar-green-dark);
        box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.1);
        background-color: #ffffff;
    }

    .form-label-custom {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    /* 📋 Manifest Card */
    .manifest-card {
        background: #ffffff;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-premium);
        padding: 36px;
        box-shadow: var(--shadow-lg);
    }

    /* 🎫 Top Banner Data Sheet */
    .manifest-top-banner {
        background: linear-gradient(135deg, #091e14 0%, #032b16 50%, var(--safar-dark-slate) 100%);
        border-radius: var(--radius-interactive);
        padding: 24px 28px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.03);
    }

    /* 👥 Dynamically Allocated Passenger Blocks */
    .passenger-block {
        background: #f8fafc;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-interactive);
        padding: 20px;
        transition: var(--transition-smooth);
        margin-bottom: 16px;
    }

    .passenger-block:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
    }

    .berth-badge {
        background-color: var(--safar-dark-slate);
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.03em;
        padding: 6px 12px;
        border-radius: 6px;
        display: inline-block;
    }

    /* ⚡ Action Button Trigger */
    .btn-premium-action {
        background: var(--safar-green-brand);
        color: #ffffff;
        border: none;
        width: 100%;
        padding: 18px;
        font-weight: 700;
        font-size: 15px;
        border-radius: var(--radius-interactive);
        transition: var(--transition-smooth);
        box-shadow: 0 4px 12px rgba(0, 77, 38, 0.1);
    }

    .btn-premium-action:hover {
        background: #02381c;
        transform: translateY(-1px);
        box-shadow: 0 8px 24px rgba(0, 77, 38, 0.2);
    }

    .btn-premium-action:active {
        transform: translateY(1px);
    }
</style>

<div class="container" style="max-width: 780px; margin-top: 40px; margin-bottom: 60px;">

    <div class="mb-4 px-1">
        <span class="badge mb-2" style="background: #dcfce7; color: var(--safar-green-dark); font-weight: 800; padding: 6px 12px; border-radius: 6px; font-size: 11px; letter-spacing: 0.05em;">
            STEP 2: PASSENGER REGISTRATION
        </span>
        <h2 style="font-weight: 800; color: var(--safar-dark-slate); letter-spacing: -0.02em; margin-top: 4px;">
            Passenger Details
        </h2>
        <p class="text-muted small mb-0">Provide valid passenger profiles for custom AI seating placement and routing.</p>
    </div>

    <div class="manifest-card">

        <div class="manifest-top-banner mb-5 text-white d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="small opacity-50 d-block fw-bold tracking-wide" style="font-size: 10px; letter-spacing: 0.05em;">ROUTE TERMINALS</span>
                <strong class="text-white" style="font-size: 17px; font-weight: 700;">🟢 @Model.Src &rarr; 🔴 @Model.Dest</strong>
            </div>
            <div class="text-md-end">
                <span class="small opacity-50 d-block fw-bold tracking-wide" style="font-size: 10px; letter-spacing: 0.05em;">FARE MATRIX</span>
                <strong style="font-size: 20px; font-weight: 800; color: var(--safar-gold); letter-spacing: -0.01em;">Rs. @Model.Fare.ToString("N0") / Seat</strong>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Src" />
            <input type="hidden" asp-for="Dest" />
            <input type="hidden" asp-for="Date" />
            <input type="hidden" asp-for="Class" />
            <input type="hidden" asp-for="Fare" />

            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2" style="font-size: 15px;">
                <span>📞</span> Primary Passenger (Lead Contact)
            </h6>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label form-label-custom">Full Name</label>
                    <input type="text" asp-for="LeadName" class="form-control" placeholder="e.g., M Talal Ashraf" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label form-label-custom">Phone Number</label>
                    <input type="tel" asp-for="LeadPhone" class="form-control" placeholder="e.g., 03XXXXXXXXX" required />
                </div>
                <div class="col-12">
                    <label class="form-label form-label-custom">CNIC / B-Form Number</label>
                    <input type="text" asp-for="LeadCNIC" class="form-control" placeholder="e.g., 37405-XXXXXXX-X" required />
                </div>
            </div>

            <div class="p-3 mb-4 mt-3" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border-radius: var(--radius-interactive); border: 1px solid #bbf7d0;">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2" style="font-size: 14px;">
                    <span>🧠</span> Lead Passenger AI Profile (Seating Optimizer)
                </h6>
                <p class="text-muted small mb-3" style="font-size: 12px;">This data helps our AI engine custom recommend the safest and most comfortable seats matching your demographics.</p>
                <div class="row g-3">
                    <div class="col-sm-4">
                        <label class="form-label form-label-custom">Age</label>
                        <input type="number" asp-for="LeadAge" class="form-control form-control-sm" placeholder="e.g., 28" min="1" max="120" required />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label form-label-custom">Gender</label>
                        <select asp-for="LeadGender" class="form-select form-select-sm">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-sm-4 d-flex align-items-end">
                        <div class="form-check" style="padding-bottom: 8px;">
                            <input type="checkbox" asp-for="IsWithFamily" class="form-check-input" id="chkFamily" />
                            <label class="form-check-label fw-bold small text-dark" for="chkFamily">Traveling with Family?</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label form-label-custom">Total Passenger Count</label>
                <select asp-for="PassengerCount" id="ddlPassengerCount" class="form-select" onchange="AdjustPassengerBlocks()">
                    @for (int p = 1; p <= 10; p++)
                    {
                        <option value="@p">@p Passenger@(p > 1 ? "s" : "")</option>
                    }
                </select>
            </div>

            <hr class="my-4" style="color: var(--border-light); opacity: 0.7;" />

            <div id="passengerBlocksContainer">
                <!-- Dynamically populated via JS -->
            </div>

            <button type="submit" class="btn-premium-action">
                ⚡ Proceed to Seat Map & Recommendation &nbsp; &rarr;
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function AdjustPassengerBlocks() {
            const count = parseInt(document.getElementById('ddlPassengerCount').value) || 1;
            const container = document.getElementById('passengerBlocksContainer');
            
            // First clear extra container child elements safely
            container.innerHTML = '';

            if (count > 1) {
                const header = document.createElement('h6');
                header.className = 'fw-bold text-dark mb-3 d-flex align-items-center gap-2';
                header.style.fontSize = '15px';
                header.innerHTML = '<span>👥</span> Co-Passenger Details';
                container.appendChild(header);
            }

            // Loop to add fields starting from Passenger 2 (since Passenger 1 is Lead details)
            for (let i = 1; i < count; i++) {
                const block = document.createElement('div');
                block.className = 'passenger-block';
                block.innerHTML = `
                    <div class="mb-3">
                        <span class="berth-badge">Passenger ${i + 1} Assignment</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label form-label-custom">Passenger Full Name</label>
                            <input type="text" name="PassengerNames" class="form-control form-control-sm" placeholder="Full name as on CNIC" required />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label form-label-custom">Age</label>
                            <input type="number" name="PassengerAges" class="form-control form-control-sm" placeholder="Years" min="1" max="120" required />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label form-label-custom">Gender</label>
                            <select name="PassengerGenders" class="form-select form-select-sm">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                `;
                container.appendChild(block);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            AdjustPassengerBlocks();
        });
    </script>
}
