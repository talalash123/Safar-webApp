@page
@model Safar.Pages.Customer.IndexModel
@{
    ViewData["Title"] = "Safar Sovereign Portal";
}

<style>
    body {
        background-color: #f8fafc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .hero-search-bg {
        background: linear-gradient(135deg, #004d26 0%, #06391d 100%);
        border-radius: 24px;
        padding: 70px 40px;
        color: #ffffff;
        box-shadow: 0 20px 40px rgba(0, 77, 38, 0.15);
        margin-bottom: 40px;
    }

    .search-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        margin-top: -50px;
        position: relative;
        z-index: 10;
    }

    .station-input {
        padding: 14px 18px;
        border-radius: 12px;
        border: 1.5px solid #cbd5e1;
        font-size: 15px;
        font-weight: 500;
        color: #0f172a;
        width: 100%;
        outline: none;
        transition: all 0.2s;
    }

        .station-input:focus {
            border-color: #004d26;
            box-shadow: 0 0 0 4px rgba(0, 77, 38, 0.08);
        }

    .btn-search-fleet {
        background: #004d26;
        color: #ffffff;
        font-weight: 700;
        padding: 16px;
        border-radius: 12px;
        border: none;
        width: 100%;
        font-size: 16px;
        box-shadow: 0 10px 20px rgba(0, 77, 38, 0.2);
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .btn-search-fleet:hover {
            background: #06391d;
            transform: translateY(-2px);
        }
</style>

<div class="container" style="max-width: 900px; margin-top: 40px; margin-bottom: 60px;">

    <div class="hero-search-bg text-center">
        <span class="badge mb-3" style="background: rgba(255,255,255,0.15); color: #fff; font-weight: 600; padding: 8px 16px; border-radius: 30px; letter-spacing: 1px;">SAFAR SOVEREIGN TRANSIT</span>
        <h1 style="font-weight: 800; font-size: 42px; letter-spacing: -1px;">Find Your Next Journey</h1>
        <p style="opacity: 0.85; font-size: 16px;">Select your terminal routing to fetch live operational schedules.</p>
    </div>

    <div class="search-card">
        <form method="get" asp-page="./SearchResults">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-secondary small fw-bold text-uppercase">Departing From</label>
                    <input type="text" name="source" class="station-input" list="stationCluster" placeholder="Type or select origin..." autocomplete="off" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-secondary small fw-bold text-uppercase">Going To</label>
                    <input type="text" name="destination" class="station-input" list="stationCluster" placeholder="Type or select destination..." autocomplete="off" required />
                </div>
            </div>

            <datalist id="stationCluster">
                @foreach (var station in Model.UniqueStations)
                {
                    <option value="@station"></option>
                }
            </datalist>

            <div class="row mt-4">
                <div class="col-12">
                    <button type="submit" class="btn-search-fleet">
                        🔍 Search Available Trains & Cabin Berths
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>