@page
@model Safar.Pages.Customer.SearchResultsModel
@{
    ViewData["Title"] = "Search Results - Safar";
}

<style>
    body {
        background-color: #f8fafc;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .main-container {
        max-width: 950px;
        margin: 40px auto;
    }

    .card-banner {
        background: white;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
    }

    .train-block {
        background: white;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        border-left: 6px solid #22c55e;
        transition: all 0.2s;
    }

        .train-block:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        }

    .class-btn {
        text-decoration: none;
        display: block;
        border-radius: 10px;
        padding: 14px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        transition: all 0.2s;
    }

        .class-btn:hover {
            background: #f0fdf4;
            border-color: #22c55e;
            transform: scale(1.02);
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
</style>

<div class="container main-container">

    <div class="card-banner p-4 mb-4 d-flex justify-content-between align-items-center">
        <div>
            <span class="text-uppercase text-muted small fw-bold d-block">Requested Route Segment</span>
            <h3 class="m-0 fw-bold text-dark">🟢 @Model.SearchSource &rarr; 🎯 @Model.SearchDestination</h3>
        </div>
        <div>
            <span class="badge bg-dark px-3 py-2 fs-6">📅 @Model.TravelDate.ToString("dd MMM, yyyy")</span>
        </div>
    </div>

    <h6 class="text-secondary fw-bold mb-3 text-uppercase" style="font-size: 11px; letter-spacing: 1px;">
        Available Fleet Schedules (@Model.AvailableSchedules.Count Units Found)
    </h6>

    @if (Model.AvailableSchedules.Count == 0)
    {
        <div class="card-banner text-center p-5 border border-dashed">
            <span style="font-size: 48px;">⚠️</span>
            <h4 class="fw-bold text-danger mt-3">No Operational Trains Found</h4>
            <p class="text-muted small">We couldn't locate any active assets operating on this route segment for the selected day.</p>
            <a href="/Customer/Index" class="btn btn-dark px-4 mt-2">Modify Query</a>
        </div>
    }
    else
    {
        @foreach (var train in Model.AvailableSchedules)
        {
            <div class="train-block p-4 mb-4 shadow-sm">
                <div class="row align-items-center">

                    <div class="col-lg-4 col-md-12">
                        <span class="badge bg-dark mb-2">Code: @train.TrainIdStr</span>
                        <h4 class="fw-bold text-dark m-0">@train.Name</h4>
                        <small class="text-muted d-block mt-1">Bogie Segments: <strong>@train.TotalBogies</strong></small>

                        <div class="mt-3 p-2 bg-light rounded border d-flex justify-content-between align-items-center text-center">
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">🟢 Departure</small>
                                <strong class="text-success small">@train.DepartureTime</strong>
                            </div>
                            <div class="text-muted small">&rarr;</div>
                            <div>
                                <small class="text-muted d-block" style="font-size: 10px;">🎯 Arrival</small>
                                <strong class="text-primary small">@train.ArrivalTime</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-8 col-md-12 mt-4 mt-lg-0">
                        <span class="text-muted small fw-bold d-block text-lg-end mb-2 text-uppercase" style="font-size: 11px;">Select Travel Class Category</span>

                        <div class="row g-2">
                            <div class="col-md-4">
                                <a href="/Customer/SelectSeats?id=@train.Id&src=@Model.SearchSource&dest=@Model.SearchDestination&date=@Model.Date&class=Economy&fare=@train.EconomyFare.ToString("F0")" class="class-btn text-center shadow-sm">
                                    <span class="fw-bold text-success d-block" style="font-size: 13px;">Economy Class</span>
                                    <h5 class="fw-bold text-dark m-0 mt-1" style="font-size: 16px;">Rs @train.EconomyFare.ToString("N0")</h5>
                                    <small class="text-muted d-block mt-2" style="font-size: 11px;">Select Seats &rarr;</small>
                                </a>
                            </div>

                            <div class="col-md-4">
                                <a href="/Customer/SelectSeats?id=@train.Id&src=@Model.SearchSource&dest=@Model.SearchDestination&date=@Model.Date&class=Business&fare=@train.BusinessFare.ToString("F0")" class="class-btn text-center shadow-sm">
                                    <span class="fw-bold text-primary d-block" style="font-size: 13px;">Business Class</span>
                                    <h5 class="fw-bold text-dark m-0 mt-1" style="font-size: 16px;">Rs @train.BusinessFare.ToString("N0")</h5>
                                    <small class="text-muted d-block mt-2" style="font-size: 11px;">Select Seats &rarr;</small>
                                </a>
                            </div>

                            <div class="col-md-4">
                                <a href="/Customer/SelectSeats?id=@train.Id&src=@Model.SearchSource&dest=@Model.SearchDestination&date=@Model.Date&class=Executive&fare=@train.ExecutiveFare.ToString("F0")" class="class-btn text-center shadow-sm">
                                    <span class="fw-bold text-warning d-block" style="font-size: 13px;">Executive Class</span>
                                    <h5 class="fw-bold text-dark m-0 mt-1" style="font-size: 16px;">Rs @train.ExecutiveFare.ToString("N0")</h5>
                                    <small class="text-muted d-block mt-2" style="font-size: 11px;">Select Seats &rarr;</small>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>