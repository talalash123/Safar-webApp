@page
@model Safar.Pages.Customer.SelectSeatsModel
@{
    ViewData["Title"] = "Select Berths - PK SAFAR";
}

<style>
    /* 🏛️ Luxury Enterprise Design System Tokens */
    :root {
        --safar-green: #22c55e;
        --safar-green-dark: #15803d;
        --safar-blue-selected: #2563eb;
        --safar-blue-hover: #1d4ed8;
        --safar-red-booked: #ef4444;
        --safar-dark-slate: #0f172a;
        --safar-green-brand: #004d26;
        --safar-gold: #fbbf24;
        --text-slate: #334155;
        --text-muted: #64748b;
        --border-light: #e2e8f0;
        --radius-premium: 16px;
        --transition-smooth: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        background-color: #f1f5f9;
        font-family: system-ui, -apple-system, sans-serif;
        color: var(--safar-dark-slate);
    }

    .portal-container {
        max-width: 1140px;
        margin: 40px auto;
        padding: 0 20px;
    }

    /* 🧭 Premium High-End Metadata Banner */
    .master-meta-strip {
        background: linear-gradient(135deg, var(--safar-dark-slate) 0%, #05331b 100%);
        border-radius: var(--radius-premium);
        padding: 24px 32px;
        color: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
    }

    .meta-title-context h4 {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin: 0;
    }

    .class-tier-badge {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.7);
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .fare-pill-badge {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        color: var(--safar-gold);
        backdrop-filter: blur(4px);
    }

    /* 🎛️ Bogie Selector Tabs Navigation */
    .bogie-navigation-panel {
        display: flex;
        gap: 12px;
        background: #e2e8f0;
        padding: 8px;
        border-radius: 12px;
        margin-bottom: 24px;
    }

    .bogie-tab-btn {
        flex: 1;
        text-align: center;
        padding: 12px;
        font-weight: 700;
        font-size: 14px;
        color: var(--text-slate);
        background: transparent;
        border: none;
        border-radius: 8px;
        text-decoration: none;
        transition: var(--transition-smooth);
    }

        .bogie-tab-btn:hover {
            background: rgba(255, 255, 255, 0.5);
            color: var(--safar-dark-slate);
        }

        .bogie-tab-btn.active-bogie {
            background: #ffffff;
            color: var(--safar-green-brand);
            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.05);
        }

    /* 🚂 Cabin Layout Container styling */
    .bogie-wrapper-card {
        background: #ffffff;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-premium);
        padding: 32px;
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.02);
    }

    /* Seat Grid Matrix Alignment Rules */
    .seats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        max-width: 420px;
        margin: 0 auto;
    }

        /* Modern Aisle Generation Configuration */
        .seats-grid div:nth-child(4n-2) {
            margin-right: 32px;
        }

    .seat-option {
        position: relative;
        display: block;
    }

        .seat-option input[type="checkbox"] {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }

    /* 💺 High-End Minimalist Seat Elements (Default Green for Available) */
    .seat-box {
        background: #f0fdf4;
        border: 2px solid var(--safar-green);
        color: var(--safar-green-dark);
        font-weight: 700;
        font-size: 14px;
        padding: 14px 0;
        border-radius: 10px;
        text-align: center;
        cursor: pointer;
        user-select: none;
        transition: var(--transition-smooth);
        display: block;
    }

        .seat-box:hover:not(.booked) {
            background: var(--safar-green);
            color: #ffffff;
        }

    /* Checked State Accent Color Integration (Blue when clicked) */
    .seat-option input[type="checkbox"]:checked ~ .seat-box {
        background: var(--safar-blue-selected) !important;
        border-color: var(--safar-blue-selected) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    /* Booked / Reserved State Rendering (Solid Red & Blocked) */
    .seat-box.booked {
        background: #fef2f2 !important;
        border-color: var(--safar-red-booked) !important;
        color: var(--safar-red-booked) !important;
        cursor: not-allowed;
        opacity: 0.85;
        font-weight: 700;
        box-shadow: none;
    }

    /* Status Legends Indicator */
    .legend-indicator-dot {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        display: inline-block;
    }

    /* 📋 Sticky Invoice Sheet Sidebar Panels */
    .summary-sticky-card {
        background: #ffffff;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-premium);
        padding: 28px;
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.02);
        position: sticky;
        top: 30px;
    }

    .ledger-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 16px 0;
    }

    .ledger-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .ledger-value {
        font-size: 14.5px;
        font-weight: 700;
        color: var(--safar-dark-slate);
    }

    .btn-premium-action {
        background: var(--safar-green-brand);
        color: #ffffff;
        border: none;
        width: 100%;
        padding: 16px;
        font-weight: 700;
        border-radius: 12px;
        transition: var(--transition-smooth);
    }

        .btn-premium-action:hover:not(:disabled) {
            background: #05331b;
            box-shadow: 0 8px 20px rgba(0, 77, 38, 0.2);
        }

        .btn-premium-action:disabled {
            background: #cbd5e1;
            color: #94a3b8;
            cursor: not-allowed;
        }

    /* 🧠 AI Recommended Seat Glow */
    .seat-box.ai-recommended {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%) !important;
        border: 2px solid #f59e0b !important;
        color: #92400e !important;
        animation: aiPulse 2s ease-in-out infinite;
        position: relative;
        font-weight: 800;
        box-shadow: 0 0 16px rgba(245, 158, 11, 0.35);
    }

    .seat-box.ai-recommended::after {
        content: '⭐';
        position: absolute;
        top: -8px;
        right: -8px;
        font-size: 14px;
        filter: drop-shadow(0 1px 2px rgba(0,0,0,0.15));
    }

    @@keyframes aiPulse {
        0%, 100% { box-shadow: 0 0 8px rgba(245, 158, 11, 0.25); }
        50% { box-shadow: 0 0 24px rgba(245, 158, 11, 0.55); }
    }

    .ai-banner {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        border: 1px solid #fcd34d;
        border-radius: 14px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.08);
    }

    .ai-banner-icon {
        font-size: 28px;
        flex-shrink: 0;
    }

    .ai-banner-badge {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
        font-size: 10px;
        font-weight: 800;
        padding: 3px 8px;
        border-radius: 4px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
</style>

<div class="container portal-container">

    <div class="master-meta-strip mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="meta-title-context">
            <span class="class-tier-badge">Selected Cabin Configuration</span>
            <h4>🚂 @Model.CurrentTrain.Name (@Model.DisplayTrainCode) &bull; <span class="text-warning">@Model.SelectedClass Class</span></h4>
        </div>
        <div>
            <div class="fare-pill-badge">
                Base Price: Rs. @Model.BaseFare.ToString("N0") / Seat
            </div>
        </div>
    </div>

    <div class="bogie-navigation-panel">
        @for (int b = 1; b <= Model.TotalBogiesCount; b++)
        {
            string prefix = Model.SelectedClass.Substring(0, 1).ToUpper();
            string bogieCode = $"{prefix}{b}";
            string activeClass = (Model.CurrentBogie == bogieCode) ? "active-bogie" : "";

            <a asp-page="./SelectSeats"
               asp-route-id="@Model.CurrentTrain.Id"
               asp-route-class="@Model.SelectedClass"
               asp-route-date="@Model.TravelDateString"
               asp-route-bogie="@bogieCode"
               asp-route-src="@Model.Src"
               asp-route-dest="@Model.Dest"
               asp-route-fare="@Model.Fare"
               asp-route-passengerCount="@Model.PassengerCount"
               asp-route-leadName="@Model.LeadName"
               asp-route-leadPhone="@Model.LeadPhone"
               asp-route-leadCNIC="@Model.LeadCNIC"
               asp-route-leadAge="@Model.LeadAge"
               asp-route-leadGender="@Model.LeadGender"
               asp-route-isWithFamily="@Model.IsWithFamily"
               asp-route-passengerManifest="@Model.PassengerManifest"
               class="bogie-tab-btn @activeClass">
                💺 Bogie @bogieCode
            </a>
        }
    </div>

    <form method="post" asp-page="./Checkout">
        <input type="hidden" name="trainId" value="@Model.CurrentTrain.Id" />
        <input type="hidden" name="selectedClass" value="@Model.SelectedClass" />
        <input type="hidden" name="travelDate" value="@Model.TravelDateString" />
        <input type="hidden" name="activeBogieCode" value="@Model.CurrentBogie" />
        <input type="hidden" name="baseFare" id="hdnBaseFare" value="@Model.BaseFare.ToString("F0")" />
        <input type="hidden" name="passengerCount" value="@Model.PassengerCount" />
        <input type="hidden" name="leadName" value="@Model.LeadName" />
        <input type="hidden" name="leadPhone" value="@Model.LeadPhone" />
        <input type="hidden" name="leadCNIC" value="@Model.LeadCNIC" />
        <input type="hidden" name="leadAge" value="@Model.LeadAge" />
        <input type="hidden" name="leadGender" value="@Model.LeadGender" />
        <input type="hidden" name="isWithFamily" value="@Model.IsWithFamily.ToString()" />
        <input type="hidden" name="passengerManifest" value="@Model.PassengerManifest" />

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="mb-3 d-flex justify-content-between align-items-center px-1">
                    <h6 class="text-uppercase text-muted fw-bold m-0" style="font-size: 11px; letter-spacing: 0.8px;">
                        Interactive Cabin Seating Map Layout (&bull; Bogie @Model.CurrentBogie)
                    </h6>
                    <span class="text-muted small fw-medium" style="font-size: 12px;">Standard 2 &times; 2 Aisle Row Configuration</span>
                </div>

                <div class="bogie-wrapper-card mb-4">
                    <div class="d-flex justify-content-center gap-4 mb-5 border-bottom pb-3 flex-wrap" style="font-size: 12.5px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="legend-indicator-dot" style="border: 2px solid var(--safar-green); background: #f0fdf4;"></span>
                            <span class="text-muted fw-medium">Available (Green)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="legend-indicator-dot" style="background: var(--safar-blue-selected);"></span>
                            <span class="text-muted fw-medium">Your Selection (Blue)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="legend-indicator-dot" style="background: #fef2f2; border: 2px solid var(--safar-red-booked);"></span>
                            <span class="text-muted fw-medium">Occupied (Red)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="legend-indicator-dot" style="background: linear-gradient(135deg, #fef3c7, #fde68a); border: 2px solid #f59e0b;"></span>
                            <span class="text-muted fw-medium">AI Recommended (Gold)</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.RecommendedSeatId))
                    {
                    <div class="ai-banner mb-4">
                        <span class="ai-banner-icon">🧠</span>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="ai-banner-badge">AI Recommendation</span>
                                <span class="fw-bold text-dark" style="font-size: 13px;">Smart Seating Engine</span>
                            </div>
                            <p class="mb-0 small" style="color: #92400e; font-size: 12.5px; line-height: 1.5;">
                                Based on your profile analysis, we recommend seat 
                                <strong class="text-dark" style="font-size: 14px;">@Model.RecommendedSeatId</strong> 
                                for optimal comfort and safety. Look for the <span style="color: #f59e0b;">⭐ glowing seat</span> below.
                            </p>
                        </div>
                    </div>
                    }

                    <div class="seats-grid">
                        @for (int i = 1; i <= Model.TotalSeatsCount; i++)
                        {
                            string compoundSeatId = $"{Model.CurrentBogie}-S{i}";
                            bool isBooked = Model.ExistingBookedSeats.Contains(compoundSeatId);

                            <div class="seat-option">
                                @if (isBooked)
                                {
                                    <span class="seat-box booked" title="Already booked for @Model.TravelDateString">@i</span>
                                }
                                else
                                {
                                    bool isRecommended = compoundSeatId == Model.RecommendedSeatId;
                                    <input type="checkbox" name="selectedSeats" value="@compoundSeatId" id="chk-@i" onchange="UpdateLivePriceLedger()" @(isRecommended ? "checked" : "") />
                                    <label for="chk-@i" class="seat-box @(isRecommended ? "ai-recommended" : "")" title="@(isRecommended ? "⭐ AI Recommended Seat" : "")">@i</label>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="summary-sticky-card">
                    <h5 class="fw-bold text-dark mb-1" style="letter-spacing: -0.3px;">Operational Cost Summary</h5>
                    <p class="text-muted small mb-0">Live calculation values based on selected inventory rows</p>

                    <hr class="my-3" style="color: var(--border-light);" />

                    <div class="ledger-row">
                        <span class="ledger-label">Active Bogie Room</span>
                        <span class="ledger-value text-end text-primary">Bogie @Model.CurrentBogie</span>
                    </div>

                    <div class="ledger-row">
                        <span class="ledger-label">Total Selected Seats</span>
                        <span class="ledger-value text-end" id="lblSeatsCount">0 Berths</span>
                    </div>

                    <div class="ledger-row flex-column align-items-stretch">
                        <div class="d-flex justify-content-between w-100">
                            <span class="ledger-label">Allocated Berth Codes</span>
                            <span class="ledger-value text-success text-end small" id="lblSeatCodes" style="max-width: 200px; word-wrap: break-word;">None Selected</span>
                        </div>
                        <span id="lblSeatWarning" class="text-danger small fw-bold mt-1 d-block text-end">⚠️ Please select @Model.PassengerCount seat(s).</span>
                    </div>

                    <hr class="my-3" style="color: var(--border-light);" />

                    <div class="d-flex justify-content-between align-items-center my-4">
                        <div>
                            <span class="text-uppercase text-muted fw-bold d-block" style="font-size: 10px; letter-spacing: 0.5px;">Aggregate Gross Payable</span>
                            <span class="small text-muted fw-medium">Taxes & fees structured inside</span>
                        </div>
                        <h3 class="fw-extrabold text-success m-0" style="font-weight: 900; letter-spacing: -0.5px;">
                            Rs. <span id="lblTotalBill">0</span>
                        </h3>
                    </div>

                    <button type="submit" id="btnProceed" class="btn-premium-action" disabled>
                        Proceed to Passenger Manifest &nbsp; &rarr;
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const requiredCount = parseInt("@Model.PassengerCount") || 1;

        function UpdateLivePriceLedger() {
            const checkboxes = document.querySelectorAll('input[name="selectedSeats"]:checked');
            const baseFare = parseFloat(document.getElementById('hdnBaseFare').value) || 0;

            let selectedCodes = [];
            checkboxes.forEach((cb) => {
                selectedCodes.push(cb.value);
            });

            const count = checkboxes.length;
            const totalBill = count * baseFare;

            document.getElementById('lblSeatsCount').textContent = count + " Berth(s) Selected (Required: " + requiredCount + ")";
            document.getElementById('lblSeatCodes').textContent = count > 0 ? selectedCodes.join(', ') : "None Selected";
            document.getElementById('lblTotalBill').textContent = totalBill.toLocaleString();

            const btn = document.getElementById('btnProceed');
            const warningEl = document.getElementById('lblSeatWarning');
            
            if (count === requiredCount) {
                btn.removeAttribute('disabled');
                if (warningEl) {
                    warningEl.textContent = "✓ Correct number of seats selected.";
                    warningEl.className = "text-success small fw-bold mt-1 d-block text-end";
                }
            } else {
                btn.setAttribute('disabled', 'disabled');
                if (warningEl) {
                    if (count < requiredCount) {
                        warningEl.textContent = "⚠️ Please select " + (requiredCount - count) + " more seat(s).";
                    } else {
                        warningEl.textContent = "⚠️ Too many seats selected! Deselect " + (count - requiredCount) + " seat(s).";
                    }
                    warningEl.className = "text-danger small fw-bold mt-1 d-block text-end";
                }
            }
        }

        // Auto-update on page load to reflect AI pre-selected seat
        document.addEventListener('DOMContentLoaded', function() {
            UpdateLivePriceLedger();
        });
    </script>
}