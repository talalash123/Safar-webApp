@page
@model Safar.Pages.Customer.CheckoutModel
@{
    ViewData["Title"] = "Passenger Manifest";
}

<style>
    /* 🏛️ Modern Luxury Enterprise Design System Tokens */
    :root {
        --safar-green: #22c55e;
        --safar-green-dark: #16a34a;
        --safar-dark-slate: #0f172a;
        --safar-green-brand: #004d26;
        --safar-gold: #fbbf24;
        --text-slate: #334155;
        --text-muted: #64748b;
        --border-light: #e2e8f0;
        --radius-premium: 20px;
        --radius-interactive: 12px;
        --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.03), 0 2px 4px -2px rgba(15, 23, 42, 0.03);
        --shadow-lg: 0 20px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
        --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        background-color: #f8fafc;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: var(--safar-dark-slate);
        -webkit-font-smoothing: antialiased;
    }

    /* 🛡️ Form Input Enhancement */
    .form-control {
        border: 1.5px solid var(--border-light);
        padding: 12px 16px;
        font-size: 14.5px;
        color: var(--safar-dark-slate);
        font-weight: 500;
        border-radius: var(--radius-interactive) !important;
        transition: var(--transition-smooth);
        background-color: #ffffff;
    }

        .form-control:focus {
            border-color: var(--safar-green-dark);
            box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.1);
            background-color: #ffffff;
        }

    .form-control-sm {
        padding: 10px 14px;
        font-size: 13.5px;
    }

    .form-label-custom {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    /* 📋 Crisp Manifest Card */
    .manifest-card {
        background: #ffffff;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-premium);
        padding: 36px;
        box-shadow: var(--shadow-lg);
    }

    /* 🎫 Top Banner Data Sheet */
    .manifest-top-banner {
        background: linear-gradient(135deg, #091e14 0%, #032b16 50%, var(--safar-dark-slate) 100%);
        border-radius: var(--radius-interactive);
        padding: 24px 28px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: var(--shadow-md);
    }

    /* 👥 Dynamically Allocated Passenger Blocks */
    .passenger-block {
        background: #f8fafc;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-interactive);
        padding: 20px;
        transition: var(--transition-smooth);
    }

        .passenger-block:hover {
            background: #f1f5f9;
            border-color: #cbd5e1;
        }

    .berth-badge {
        background-color: var(--safar-dark-slate);
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.03em;
        padding: 6px 12px;
        border-radius: 6px;
        display: inline-block;
    }

    /* ⚡ Action Button Trigger */
    .btn-premium-action {
        background: var(--safar-green-brand);
        color: #ffffff;
        border: none;
        width: 100%;
        padding: 18px;
        font-weight: 700;
        font-size: 15px;
        border-radius: var(--radius-interactive);
        transition: var(--transition-smooth);
        box-shadow: 0 4px 12px rgba(0, 77, 38, 0.1);
    }

        .btn-premium-action:hover {
            background: #02381c;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(0, 77, 38, 0.2);
        }

        .btn-premium-action:active {
            transform: translateY(1px);
        }
</style>

<div class="container" style="max-width: 780px; margin-top: 40px; margin-bottom: 60px;">

    <div class="mb-4 px-1">
        <span class="badge mb-2" style="background: #dcfce7; color: var(--safar-green-dark); font-weight: 800; padding: 6px 12px; border-radius: 6px; font-size: 11px; letter-spacing: 0.05em;">
            STEP 4: SECURITY PROTOCOL
        </span>
        <h2 style="font-weight: 800; color: var(--safar-dark-slate); letter-spacing: -0.02em; margin-top: 4px;">
            Passenger Manifest Registry
        </h2>
        <p class="text-muted small mb-0">Provide valid identity criteria for each selected berth mapping safely.</p>
    </div>

    <div class="manifest-card">

        <div class="manifest-top-banner mb-5 text-white d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="small opacity-50 d-block fw-bold tracking-wide" style="font-size: 10px; letter-spacing: 0.05em;">SELECTED BERTHS MATRIX</span>
                <strong class="text-white" style="font-size: 17px; font-weight: 700;">🎫 @string.Join(", ", Model.SelectedSeatsList)</strong>
            </div>
            <div class="text-md-end">
                <span class="small opacity-50 d-block fw-bold tracking-wide" style="font-size: 10px; letter-spacing: 0.05em;">TOTAL PAYABLE VALUE</span>
                <strong style="font-size: 22px; font-weight: 800; color: var(--safar-gold); letter-spacing: -0.01em;">Rs. @Model.TotalPayable.ToString("N0")</strong>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="TrainId" />
            <input type="hidden" asp-for="SelectedClass" />
            <input type="hidden" asp-for="TravelDateString" />
            <input type="hidden" asp-for="TotalPayable" />
            <input type="hidden" asp-for="SeatsRawData" />
            <input type="hidden" name="baseFare" value="@Model.BaseFare" />
            <input type="hidden" asp-for="LeadName" />
            <input type="hidden" asp-for="LeadPhone" />
            <input type="hidden" asp-for="LeadCNIC" />
            <input type="hidden" asp-for="LeadAge" />
            <input type="hidden" asp-for="LeadGender" />
            <input type="hidden" asp-for="IsWithFamily" />
            <input type="hidden" asp-for="PassengerCount" />
            <input type="hidden" asp-for="PassengerManifest" />

            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2" style="font-size: 15px;">
                <span>📞</span> Lead Passenger (Primary Contact Details)
            </h6>

            <div class="row g-3 mb-4 p-3 bg-light rounded-3 border mx-0">
                <div class="col-md-4">
                    <span class="form-label form-label-custom">Full Name</span>
                    <strong class="text-dark d-block">@Model.LeadName</strong>
                </div>
                <div class="col-md-4">
                    <span class="form-label form-label-custom">Phone Number</span>
                    <strong class="text-dark d-block">@Model.LeadPhone</strong>
                </div>
                <div class="col-md-4">
                    <span class="form-label form-label-custom">CNIC / B-Form</span>
                    <strong class="text-dark d-block">@Model.LeadCNIC</strong>
                </div>
            </div>

            <div class="p-3 mb-4 mt-3 border" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border-radius: var(--radius-interactive); border-color: #bbf7d0 !important;">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2" style="font-size: 14px;">
                    <span>🧠</span> Smart Seating Profile Inputs
                </h6>
                <div class="row g-3">
                    <div class="col-sm-4">
                        <span class="form-label form-label-custom">Age</span>
                        <strong class="text-dark d-block">@Model.LeadAge Years</strong>
                    </div>
                    <div class="col-sm-4">
                        <span class="form-label form-label-custom">Gender</span>
                        <strong class="text-dark d-block">@Model.LeadGender</strong>
                    </div>
                    <div class="col-sm-4">
                        <span class="form-label form-label-custom">Traveling with Family?</span>
                        <strong class="text-dark d-block">@(Model.IsWithFamily ? "Yes" : "No")</strong>
                    </div>
                </div>
            </div>

            <hr class="my-4" style="color: var(--border-light); opacity: 0.7;" />

            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2" style="font-size: 15px;">
                <span>👥</span> Passenger Manifest & Seat Assignments
            </h6>

            <div class="d-flex flex-column gap-3 mb-4">
                @for (int i = 0; i < Model.ParsedPassengers.Count; i++)
                {
                    var p = Model.ParsedPassengers[i];
                    var assignedSeat = Model.SelectedSeatsList.Count > i ? Model.SelectedSeatsList[i] : "Unassigned";

                    <div class="passenger-block d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <span class="berth-badge mb-2">Passenger @(i + 1)</span>
                            <div class="fw-bold text-dark" style="font-size: 15.5px;">@p.Name</div>
                            <span class="text-muted small">Age: @p.Age &bull; Gender: @p.Gender</span>
                        </div>
                        <div class="text-end">
                            <span class="form-label form-label-custom text-uppercase">Assigned Berth</span>
                            <strong class="text-success" style="font-size: 18px; font-weight: 800;">🎫 @assignedSeat</strong>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mb-4">
                <a href="/Customer/PassengerInfo?id=@Model.TrainId&src=@Request.Query["src"]&dest=@Request.Query["dest"]&date=@Model.TravelDateString&class=@Model.SelectedClass&fare=@Model.BaseFare&LeadName=@Model.LeadName&LeadPhone=@Model.LeadPhone&LeadCNIC=@Model.LeadCNIC&LeadAge=@Model.LeadAge&LeadGender=@Model.LeadGender&IsWithFamily=@Model.IsWithFamily&PassengerCount=@Model.PassengerCount" 
                   class="text-decoration-none small fw-bold text-primary">
                    ✏️ Modify Passenger Demographics or Contact Details
                </a>
            </div>

            <button type="submit" class="btn-premium-action">
                ⚡ Finalize Booking & Generate Digital Ticket &nbsp; &rarr;
            </button>
        </form>
    </div>
</div>